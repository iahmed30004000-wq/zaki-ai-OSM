<?xml version="1.0" encoding="utf-8"?>
<!-- The pairing token never leaves the phone: no cloud backup, no device-to-device copy. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
