// SALESFLOW - E-Commerce Sales, Orders, Profit & Business Intelligence System
// Multi-Tenant, RBAC, Manufacturing, Inventory, CRM, Orders, Profit & AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("USD")
  country   String   @default("US")
  logo      String?
  settings  String? // JSON configuration: shipping defaults, commissions, AI prefs
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  products              Product[]
  batches               ProductionBatch[]
  batchCostLines        ProductionBatchCost[]
  apps                  App[]
  appInstalls           AppInstall[]
  inventoryMovements    InventoryMovement[]
  offers                Offer[]
  customers             Customer[]
  orders                Order[]
  callLogs              CallLog[]
  activities            OrderActivity[]
  expenses              Expense[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  attendanceMarks       AttendanceMark[]
  aiSummaries           AiDailySummary[]
  productImages         ProductImage[]
  deliveryProviders     DeliveryProvider[]
  shippingBatches       ShippingBatch[]
  financialTransactions FinancialTransaction[]
  landingPages          LandingPage[]
  orderAddOns           OrderAddOn[]
  roles                 Role[]
  navArrangements       NavArrangement[]
  categories            Category[]
  whatsappConnections   WhatsAppConnection[]
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  telegramSources       TelegramSource[]
  telegramMessages      TelegramMessage[]
  trackingPixels        TrackingPixel[]
  countries             Country[]
  customerBlocks        CustomerBlock[]
  orderChannels         OrderChannel[]
  stores                Store[]
  fonts                 StoreFont[]
  campaigns             Campaign[]
  adAccounts            AdAccount[]
  customConversions     CustomConversion[]
  penaltyRules          PenaltyRule[]
  payslips              Payslip[]
  penalties             Penalty[]
  productReviews        ProductReview[]
  systemTokens          SystemToken[]
  idempotencyRecords    IdempotencyRecord[]

  @@map("companies")
}

// ─── GLOBAL TRACKING PIXELS (additive) ───
// Centralized multi-platform tracking config (Meta / TikTok / Snapchat).
// pixelId is the ONLY stored value — no tokens, no secrets, no user JS.
// platform: META | TIKTOK | SNAPCHAT ; scope: GLOBAL | PUBLIC | LANDING_PAGES
// Loading/tracking code is 100% hard-coded in the app — never user-controlled.
model TrackingPixel {
  id        String  @id @default(uuid())
  companyId String
  platform  String // META | TIKTOK | SNAPCHAT | GOOGLE (allowlisted server-side)
  name      String
  pixelId   String // validated per-platform (digits / alphanumeric / uuid)
  enabled   Boolean @default(true)
  scope     String  @default("GLOBAL") // GLOBAL | PUBLIC | LANDING_PAGES

  /// WHICH SHOP'S VISITORS THIS PIXEL IS TOLD ABOUT — «فصل البيكسل لكل متجر
  /// وبلد حتى لو ح اولد بلد او متجر جديد».
  ///
  /// One pixel per (company, platform, pixelId) still — the unique index
  /// below is unchanged — and this row says WHERE that pixel fires. The
  /// same Meta pixel cannot be scoped two ways at once, because it is one
  /// pixel: two scopes would be two rows claiming one ad account's data.
  ///
  /// THE THREE SCOPES, AND THEY ARE MUTUALLY EXCLUSIVE (the migration holds
  /// a CHECK so only one may be set):
  ///
  ///   · both NULL — every store in the company. A DELIBERATE choice the
  ///     seller makes and the screen names out loud, not a default that
  ///     quietly swallows the next store somebody opens.
  ///   · countryId — every store in that country, including ones opened
  ///     later. That is the point of a country scope.
  ///   · storeId — that store alone.
  ///
  /// `scope` above is a different question entirely and stays: it says
  /// WHICH KIND OF PAGE (landing pages, storefronts, both). These say WHOSE.
  storeId   String?
  countryId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// THE ONE EXCEPTION to the rule above, and it is deliberate.
  ///
  /// The browser half of this pixel still stores nothing but an id, because
  /// anything a page holds travels through the customer's own browser. The
  /// Conversions API is the opposite case: it runs on the server, and it
  /// cannot speak to Meta without a token.
  ///
  /// So the token lives here under the same law as the courier logins and
  /// the ad-account secrets: encrypted at rest, verified against Meta before
  /// it is stored, never returned by any endpoint, and never written to an
  /// audit entry. Only the last four characters come back, so a seller can
  /// tell which token is in there. Null means this pixel is browser-only.
  capiToken     String?
  capiTokenHint String?
  /// Meta's Test Events code. Set while a seller is watching events arrive
  /// in Events Manager, then cleared — an event sent with it is visible in
  /// the test panel and NOT counted as a conversion.
  capiTestCode  String?
  /// The Meta dataset the server events go to, when it is not the pixel
  /// itself. For a web pixel the two are the same number — which is why this
  /// is empty for almost everybody and the pixel id is used.
  capiDatasetId String?

  /// WHAT AN ORDER IS REPORTED AS on this pixel — «شو الهدف الي بدك التحويل عليه». `Purchase` (as it always was)
  /// or `Lead`. See `ORDER_EVENTS` in tracking-types.ts.
  orderEvent           String  @default("Purchase")
  /// Whether this pixel is told a product was viewed, and that the order form was started. On by default — the
  /// events every pixel received before these switches existed.
  sendViewContent      Boolean @default(true)
  sendInitiateCheckout Boolean @default(true)

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// `Restrict`, not `Cascade`: deleting a store must not silently delete
  /// the pixel that was reporting its sales. Somebody has to decide where
  /// that pixel points now.
  store       Store?             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  country     Country?           @relation(fields: [countryId], references: [id], onDelete: Restrict)
  conversions CustomConversion[]

  @@unique([companyId, platform, pixelId])
  @@index([companyId, storeId, enabled])
  @@index([companyId, enabled, scope])
  @@index([companyId, platform, enabled])
  @@map("tracking_pixels")
}

// ─── CUSTOM CONVERSIONS (server-side, via the Conversions API) ───
/// WHAT THE SELLER DECIDES, AND WHY IT IS A ROW RATHER THAN A CONSTANT.
///
/// The browser pixel fires when a form is submitted. For a cash-on-delivery
/// shop that is not a sale — it is a person who typed their phone number,
/// and a large share of those never pay. Optimising on it teaches Meta to
/// find people who fill forms.
///
/// A custom conversion is the seller saying: THIS moment, in MY order
/// lifecycle, is the one worth buying. They choose the moment, the event
/// name Meta will see, and which number counts as the value. Nothing here
/// is inferred, because the right answer differs per product and per shop.
///
/// The event name is the seller's own, never one the browser pixel already
/// sends, so a conversion at delivery cannot be double-counted against a
/// Purchase at form-submit. That is exactly what Meta's Custom Conversions
/// are built on top of.
model CustomConversion {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  /// The pixel this is sent to — which also supplies the platform and token.
  pixelId   String @map("pixel_id")

  /// What the seller calls it, in their own words.
  name        String
  /// What Meta receives. Letters, digits and underscores; validated server-side.
  eventName   String  @map("event_name")
  /// order.created | order.confirmed | order.delivered — the existing event
  /// vocabulary, not a second one invented for this table.
  trigger     String
  /// ORDER_TOTAL | COLLECTED_AMOUNT | NONE. At delivery the collected amount
  /// is the true figure: what the customer actually handed over, which is
  /// not always what was ordered.
  valueSource String  @default("ORDER_TOTAL") @map("value_source")
  enabled     Boolean @default(true)

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pixel      TrackingPixel        @relation(fields: [pixelId], references: [id], onDelete: Cascade)
  deliveries ConversionDelivery[]

  @@unique([pixelId, eventName, trigger])
  @@index([companyId, enabled])
  @@map("custom_conversions")
}

/// ONE ROW PER CONVERSION PER ORDER, FOR EVER.
///
/// Written when the order reaches the moment, sent by the worker. Never
/// inline: an order must not fail to save because Meta is slow, and a sale
/// that happened has happened whatever any advertising platform thinks.
///
/// NO PERSONAL DATA IS STORED HERE. The row holds the order id and the
/// worker re-reads the customer at send time to hash them. A queue that
/// kept the phone number would be a second copy of the customer database
/// with none of its protections.
///
/// The unique pair is the whole guarantee against double counting: a retry,
/// a replay, two workers, or a status set to DELIVERED twice all collapse
/// into the one row that already exists.
model ConversionDelivery {
  id           String @id @default(uuid())
  companyId    String @map("company_id")
  conversionId String @map("conversion_id")
  orderId      String @map("order_id")

  /// Sent to Meta as event_id. Meta deduplicates on it too, so a row that
  /// somehow sends twice is still counted once on their side.
  eventId String @map("event_id")

  /// PENDING | SENT | FAILED | SKIPPED
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at")
  /// How much of a match we could offer, 0–1. The only way anyone finds out
  /// that events are arriving and matching nobody.
  matchQuality  Float?    @map("match_quality")
  createdAt     DateTime  @default(now()) @map("created_at")

  conversion CustomConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([conversionId, orderId])
  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@map("conversion_deliveries")
}

model User {
  id                 String    @id @default(uuid())
  companyId          String?
  email              String    @unique
  name               String
  passwordHash       String
  role               String    @default("PENDING_USER") // SUPER_ADMIN, COMPANY_ADMIN, MANAGER, MODERATOR, CONFIRMATION_AGENT, FOLLOW_UP_AGENT, SETTLEMENT_OFFICER, ACCOUNTANT, DELIVERY_MANAGER, PENDING_USER
  phone              String?
  /// The currency this person's commission is counted in. Null = the store's,
  /// which is how it always worked. An Egyptian moderator is paid in pounds
  /// even where there is no pound wallet: the money leaves a wallet of
  /// another currency at a rate the owner writes when they pay it.
  commissionCurrency String?   @map("commission_currency")
  avatar             String?
  commissionRate     Float     @default(0.0)
  status             String    @default("PENDING") // PENDING, ACTIVE, SUSPENDED, DISABLED
  /// When this person starts and hands over, as "HH:mm" in the country's
  /// timezone. NULL means the country's own work hours — so nothing changes
  /// for anybody until a shift is set on purpose.
  ///
  /// Lateness, early leaving and every penalty built on them are measured
  /// against THESE. Measuring a noon shift against a nine o'clock country
  /// makes somebody three hours late every day of their life.
  /// What this person is paid, and in what. Null = no salary on file,
  /// which is every employee until somebody enters one: a salary is a
  /// deliberate entry and never a default.
  /// Which of the system's looks this person chose. Null = the default.
  /// On the user rather than in browser storage: somebody who works from
  /// the counter and from a laptop chose once, not twice.
  systemTheme        String?   @map("system_theme")
  /// Whether the one-time first-run tour was dismissed for good. Null = it
  /// has not run (or was skipped without «ما بدي أشرح مرة ثانية»), so the
  /// next sign-in opens it again. Like the theme, it is on the USER and not
  /// in browser storage: one choice per person, not one per device.
  tourDoneAt         DateTime? @map("tour_done_at")
  salaryAmount       Decimal?  @map("salary_amount") @db.Decimal(14, 3)
  salaryCurrency     String?   @map("salary_currency")
  shiftStart         String?   @map("shift_start") @db.VarChar(5)
  shiftEnd           String?   @map("shift_end") @db.VarChar(5)
  /// Their rest days as comma-separated weekday numbers (0 = Sunday).
  /// NULL = the country's weekend. A night shift does not rest on Friday.
  restDays           String?   @map("rest_days")
  tokenVersion       Int       @default(0)
  lastLoginAt        DateTime?
  assignedById       String?
  assignedAt         DateTime?
  resetToken         String?
  resetTokenExpires  DateTime?

  /// THE SECOND FACTOR, FOR THE ROLES THAT MOVE MONEY.
  ///
  /// The secret is encrypted with the app key, like a courier's password:
  /// a database copy alone must not hand somebody a working authenticator.
  /// `totpLastStep` is the 30-second step most recently spent, so the same
  /// code cannot be replayed inside its own window.
  totpSecretEnc String?
  totpEnabledAt DateTime?
  totpLastStep  Int?
  /// THE CODE THE OWNER ISSUED FOR THE FIRST SETUP OF THE SECOND FACTOR (A2).
  /// Only the bcrypt hash is kept, so a copy of the table is not a working code. It is spent
  /// (both columns back to null) in the same transaction that saves the enrolment, and it
  /// expires on its own. Read only while AUTH_ENROL_CODE_REQUIRED is on.
  enrolCodeHash      String?   @map("enrol_code_hash")
  enrolCodeExpiresAt DateTime? @map("enrol_code_expires_at")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// THE FINGERPRINT ON THE DEVICE ALREADY IN THE HAND.
  ///
  /// A passkey stands in for the six-digit code, never for the password: a
  /// phone that is picked up is a second factor that is already lost.
  passkeys                      Passkey[]
  navArrangement                NavArrangement[]
  passkeyChallenges             PasskeyChallenge[]
  company                       Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enteredOrders                 Order[]                 @relation("OrderCreator")
  assignedOrders                Order[]                 @relation("ModeratorOrders")
  claimedOrders                 Order[]                 @relation("OrderClaimer")
  ownedOrders                   Order[]                 @relation("OrderCurrentOwner")
  lockedOrders                  Order[]                 @relation("OrderLockHolder")
  assignedWork                  Order[]                 @relation("OrderAssignee")
  signedOrders                  Order[]                 @relation("OrderSignedBy")
  callLogs                      CallLog[]
  auditLogs                     AuditLog[]
  recoveryCodes                 TwoFactorRecoveryCode[]
  attendanceMarks               AttendanceMark[]
  claimHistory                  OrderClaimHistory[]
  statusLogs                    OrderStatusLog[]
  contactAttempts               OrderContactAttempt[]
  createdLandingPages           LandingPage[]           @relation("LandingPageCreator")
  confirmedOrders               Order[]                 @relation("OrderConfirmedBy")
  resolvedFollowUps             Order[]                 @relation("FollowUpResolvedBy")
  createdShippingBatches        ShippingBatch[]         @relation("ShippingBatchCreator")
  deliveryAgentAttempts         DeliveryAttempt[]       @relation("DeliveryAttemptAgent")
  financialTransactions         FinancialTransaction[]  @relation("FinanceTransactionActor")
  assignedDeliveryOrders        Order[]                 @relation("DeliveryAssignedBy")
  assignedBy                    User?                   @relation("UserAssigner", fields: [assignedById], references: [id])
  assignedUsers                 User[]                  @relation("UserAssigner")
  roleId                        String?
  roleRef                       Role?                   @relation(fields: [roleId], references: [id], onDelete: SetNull)
  permissionsVersion            Int                     @default(1)
  userPermissions               UserPermission[]
  permissionsGranted            UserPermission[]        @relation("UserPermissionGranter")
  whatsappAssignedConversations WhatsAppConversation[]  @relation("WhatsAppAssignee")
  countryAccess                 UserCountryAccess[]
  storeAccess                   UserStoreAccess[]
  penalties                     Penalty[]
  payslips                      Payslip[]
  notifications                 Notification[]
  customerBlocks                CustomerBlock[]         @relation("CustomerBlockedBy")
  customerBlockReleases         CustomerBlock[]         @relation("CustomerBlockReleasedBy")
  reviewsAdded                  ProductReview[]         @relation("ReviewAuthor")
  reviewsHidden                 ProductReview[]         @relation("ReviewHider")

  @@index([companyId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Product {
  id            String   @id @default(uuid())
  companyId     String
  /// Which store's catalogue this article belongs to. A store here is a
  /// separate business: its own goods, its own stock, its own shelf.
  /// Null only until a product from before this is placed.
  storeId       String?  @map("store_id")
  name          String
  nameEn        String?
  sku           String
  description   String?
  descriptionEn String?
  image         String?
  // How this product's stock comes in. MANUFACTURED opens a production batch
  // with a cost breakdown; PURCHASED opens a receiving batch with one unit
  // cost. Both land in the same ledger — this only picks the door.
  sourceType    String? // 'MANUFACTURED' | 'PURCHASED'
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, OUT_OF_STOCK
  basePrice     Float    @default(0.0)
  /// A READABLE ADDRESS, in the language the shop is written in.
  ///
  /// `/p/EAR-01` tells a shopper nothing. `/p/كريم-الأذن` is the product's
  /// own name — and a link is read before it is tapped, especially the
  /// ones that go round a family group.
  ///
  /// Nullable: a product saved before this has none, and the route falls
  /// back to its SKU rather than inventing one. Unique per STORE, not per
  /// company: two shops may both sell «كريم مرطّب».
  slug          String?
  /// The addresses it used to have, newest first, as a JSON array.
  ///
  /// «تغيير رابط منتج بيولّد إعادة توجيه تلقائية». A product renamed
  /// after its link has spread must not answer 404 — that link is the
  /// shop's advertising and it keeps being tapped for weeks.
  ///
  /// Here and not in the seller's redirect screen: this is generated, not
  /// authored, and a seller deleting a row there would silently break
  /// every old link without being told what it was for.
  previousSlugs String?  @db.Text
  categoryId    String?
  /// WHERE THIS PRODUCT'S SOCIAL PROOF COMES FROM — owner decision D8.
  ///
  /// `manual` · `auto` · `both`, and NULL, which READS AS `manual` in
  /// src/lib/product-reviews.ts. Nullable with no default deliberately:
  /// the migration writes into no existing row, and a product with no
  /// delivered orders has nothing automatic to show, so «manual» is the
  /// only honest fallback.
  ///
  /// It is per PRODUCT and not per store because the choice is about one
  /// article's evidence. A shop may sell one thing with forty delivered
  /// orders and launch another this morning; a store-wide switch would
  /// make the new one borrow the old one's credibility.
  ///
  /// At five published VERIFIED reviews the system moves a product here to
  /// `auto` by itself and tells the owner, who can move it back — the
  /// floor is `AUTO_SWITCH_FLOOR`, and it is the same 5 as
  /// `delivery-time.ts`'s `MIN_DELIVERIES` on purpose: one number a reader
  /// has already learned.
  reviewMode    String?  @map("review_mode")
  /// THIS PRODUCT'S ANSWERS to its category's questions, as JSON.
  ///
  /// Read against the category's schema and kept only where they still fit
  /// it: a seller who renames a field loses an answer, not a product page.
  attributes    String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store              Store?                      @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category           Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches            ProductionBatch[]
  inventoryMovements InventoryMovement[]
  offers             Offer[]
  orders             Order[]
  orderItems         OrderItem[]
  landingPages       LandingPage[]
  campaigns          Campaign[]
  recommendations    LandingPageRecommendation[]
  addOns             OrderAddOn[]
  images             ProductImage[]
  reviews            ProductReview[]

  @@unique([companyId, storeId, sku])
  @@index([companyId, storeId])
  @@index([companyId])
  @@index([storeId, slug])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid())
  companyId  String
  productId  String
  url        String
  storageKey String
  fileName   String
  mimeType   String
  fileSize   Int
  altText    String?
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@map("product_images")
}

/// WHAT A BUYER SAID — and whether anybody can check that they bought it.
///
/// Owner decision D8, design docs/storefront/AUDIT.md §7.6. It lives in the
/// CORE and not in an app: publishing or hiding a review WRITES AN AUDIT
/// ROW, and `stages.md:200` forbids an app from editing the audit log.
///
/// ── ALSO HELD BY THE DATABASE: `product_reviews_order_key` ──
///
/// `CREATE UNIQUE INDEX product_reviews_order_key ON product_reviews
/// (order_id) WHERE order_id IS NOT NULL` — in
/// 20261015240000_reviews_and_the_counter. Prisma cannot express a partial
/// unique index, so there is nothing on this model to find it by, which is
/// what `a-rule-the-schema-hides.test.ts` exists to stop; this paragraph is
/// the fix.
///
/// It does TWO jobs that are really one. `orderId` is what tells a verified
/// review from a manual one, so an `@@unique([orderId])` here would cover
/// every manual row as well — and Postgres counts each NULL as distinct, so
/// it would appear to constrain them while constraining nothing. And it is
/// the whole of «a rating link works ONCE»: the link stores no token, it is
/// an HMAC over the order id (src/lib/review-link.ts), and a second
/// submission on a perfectly valid link lands on this index. The refusal is
/// loud instead of being a second opinion from one buyer.
model ProductReview {
  id        String  @id @default(uuid())
  companyId String
  storeId   String? @map("store_id")
  productId String  @map("product_id")
  /// THE DELIVERED ORDER THIS RATING CAME FROM, or null for a manual item.
  ///
  /// It is the badge. «مشتري مؤكَّد» is rendered off the presence of this
  /// column and nothing else — never off `source`, never off a flag a
  /// seller could set — so a transcribed WhatsApp message cannot wear it,
  /// because there is no order to put here.
  orderId   String? @map("order_id")
  /// One to five. The database holds the range too:
  /// CHECK (rating >= 1 AND rating <= 5), in the same migration.
  rating    Int
  /// THE CUSTOMER'S OWN WORDS, AS TEXT AND ONLY EVER AS TEXT.
  ///
  /// Not rich text: every other free field on a page is the SELLER's and
  /// goes through src/lib/rich-text.ts's allowlist. This is what a stranger
  /// typed into a public form, rendered as a React text child so there is
  /// no markup question to get wrong. It is DATA — not to a renderer and
  /// not to a model: any AI reading it goes through
  /// `aiChat({ localOnly: true })`.
  text      String? @db.Text
  /// A first name and a city, and there is nowhere here for anything else.
  /// The privacy promise is kept by the ABSENCE of a phone column, an
  /// address column and a full-name column, not by a filter in a renderer
  /// somebody can widen.
  firstName String? @map("first_name")
  city      String?
  /// order | whatsapp | facebook | call | other — see REVIEW_SOURCES.
  source    String
  /// PENDING | PUBLISHED | HIDDEN
  status    String  @default("PENDING")
  /// The tick on the rating page.
  ///
  /// Kept apart from `status` on purpose: a moderator may publish, and may
  /// not consent on somebody else's behalf. A row with `consent: false` is
  /// never shown however its status reads.
  consent   Boolean @default(false)

  publishedAt  DateTime? @map("published_at")
  /// Hiding is for abuse, personal data or off topic — and it carries the
  /// reason. «Hidden» with no reason is a seller deleting a three-star and
  /// calling it moderation, so the service refuses an empty one.
  hiddenReason String?   @map("hidden_reason")
  hiddenById   String?   @map("hidden_by_id")
  hiddenAt     DateTime? @map("hidden_at")
  /// An optional PRIVATE proof image for a manual item — the screenshot of
  /// the message the seller is transcribing. Never rendered publicly: it is
  /// somebody's chat, and it is here so the claim can be checked, not shown.
  proofImage   String?   @map("proof_image")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store?  @relation(fields: [storeId], references: [id], onDelete: SetNull)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// SetNull and not Cascade: an order leaving the system does not retract
  /// the rating its customer gave. The row loses its badge, because the
  /// badge IS this column, and stays a review somebody wrote.
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("ReviewAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  hiddenBy  User?   @relation("ReviewHider", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([companyId, status])
  @@index([storeId])
  @@map("product_reviews")
}

model ProductionBatch {
  id                  String   @id @default(uuid())
  /// Where these goods physically are. Stock is the store's, not the
  /// company's: two stores selling out of one pile can each promise what
  /// the other has already taken.
  storeId             String?  @map("store_id")
  companyId           String
  productId           String
  batchNumber         String
  quantityProduced    Int
  quantitySold        Int      @default(0)
  quantityRemaining   Int
  manufacturingCost   Float    @default(0.0)
  packagingCost       Float    @default(0.0)
  rawMaterialCost     Float    @default(0.0)
  otherCosts          Float    @default(0.0)
  totalProductionCost Float    @default(0.0)
  costPerUnit         Float    @default(0.0)
  productionDate      DateTime @default(now())
  notes               String?
  status              String   @default("COMPLETED") // IN_PROGRESS, COMPLETED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  /// Set when this batch came from the opening physical count at cutover.
  /// The count's batches ARE its lines: quantity and unit cost live here and
  /// nowhere else, so there is no second copy of them to drift.
  openingCountId String?

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryMovements InventoryMovement[]
  costLines          ProductionBatchCost[]
  openingCount       StockOpeningCount?    @relation(fields: [openingCountId], references: [id], onDelete: SetNull)

  @@unique([companyId, batchNumber])
  @@index([companyId, productId])
  @@map("production_batches")
}

/// One named cost on a production batch — "قالب", "أجرة عامل", "شحن المواد".
/// The four fixed buckets on the batch stay for the batches that use them;
/// a batch's total is those four plus these lines.
/// THE SIGNED PHYSICAL COUNT OF STOCK AT CUTOVER.
///
/// A physical count already existed: the «الجرد» door on `/api/inventory`
/// takes a counted quantity and a written reason, works out the difference,
/// and enters any surplus at the cost of the stock already there rather than
/// at zero — its own comment explains that units at zero cost overstate the
/// profit of everything sold afterwards. None of that is rebuilt.
///
/// What this adds is what the cutover asks for and that door cannot answer:
/// WHO COUNTED, and the fact that this particular count is the one the
/// business started from. One row per store, ever.
///
/// There is no `Warehouse` in this system — stock belongs to a STORE
/// (`ProductionBatch.storeId`), and a store here is a separate business with
/// its own shelf. So «stock per warehouse» is stock per store, which for the
/// launch scope is one count for صحة بلس.
model StockOpeningCount {
  id            String   @id @default(uuid())
  companyId     String
  storeId       String   @unique
  /// The person who physically counted. Free text: the keeper holding the
  /// shelf may have no login, and a user id here would turn «who counted»
  /// into «who typed».
  countedByName String
  countedAt     DateTime
  note          String?
  /// The system user who entered it. Distinct from countedByName by design.
  recordedById  String
  createdAt     DateTime @default(now())

  store   Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  batches ProductionBatch[]

  @@index([companyId, countedAt])
  @@map("stock_opening_counts")
}

model ProductionBatchCost {
  id        String   @id @default(uuid())
  companyId String
  batchId   String
  label     String
  amount    Float    @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batch   ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("production_batch_costs")
}

model InventoryMovement {
  id           String   @id @default(uuid())
  /// The store whose stock moved. The log has to answer the same question
  /// the balance does.
  storeId      String?  @map("store_id")
  companyId    String
  productId    String
  batchId      String?
  type         String // PRODUCTION, SALE, RETURN, MANUAL_ADJUSTMENT
  quantity     Int // positive for addition, negative for deduction
  balanceAfter Int
  referenceId  String? // orderId, batchId, etc.
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([batchId])
  // The ledger is read per store, newest first.
  @@index([companyId, storeId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

model Offer {
  id               String    @id @default(uuid())
  companyId        String
  productId        String
  name             String
  quantity         Int       @default(1)
  // Units given free on top of `quantity` — "3 قطع + 1 مجاناً".
  freeQuantity     Int       @default(0)
  sellingPrice     Float
  /// The CEILING on a struck-through "was" price. Display only: it never
  /// enters computeCod, and it is shown only as far as real delivered orders
  /// support it — see src/lib/price-honesty.ts. It used to be shown as typed,
  /// and the offers screen filled it in from arithmetic, so the saving a
  /// customer read was measured against a price nobody had ever paid.
  compareAtPrice   Float?
  /// When this bundle stops being for sale. Null means it does not.
  ///
  /// The countdown a customer sees and the moment the price stops applying
  /// are ONE column on purpose. A clock with a source of its own reaches zero
  /// while the offer carries on, and the customer learns the number is
  /// decoration. `liveOfferWhere` is the only reader of both.
  endsAt           DateTime?
  discount         Float     @default(0.0)
  deliveryIncluded Boolean   @default(true)
  /// SHOWN ONLY AFTER AN ORDER EXISTS — «زيد علبة كمان؟ 15 بدل 25».
  ///
  /// The one fact that separates the offer on the thank-you screen from the
  /// bundles a visitor chooses between at the door. It is a flag and not a
  /// table because a second table is a second place a price lives, and this
  /// product already paid for that lesson once: a landing page carried its
  /// own copy of the three tiers and went on selling at a price the
  /// catalogue had raised.
  ///
  /// A true here WITHHOLDS the bundle from every door — `liveOfferWhere`
  /// excludes it, so the landing page, the storefront grid, the product
  /// page, the cart quote and `createPublicOrder` cannot reach it. That is
  /// the whole point: an after-order price a visitor can simply pick at the
  /// door is not an after-order price, it is a price cut.
  ///
  /// One per product, kept by `clearOtherPostOrderOffers` and not by a
  /// partial unique index — see the migration for why the index cannot
  /// work here.
  postOrderOffer   Boolean   @default(false)
  // The bundle preselected on the landing page and the quick-order screen.
  isDefault        Boolean   @default(false)
  sortOrder        Int       @default(0)
  status           String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([companyId, productId])
  @@index([productId, status, sortOrder])
  @@index([status, endsAt])
  @@map("offers")
}

model Customer {
  id                 String    @id @default(uuid())
  companyId          String
  /// Which store serves this person. The stores are separate businesses: the
  /// same customer may buy from two of them, and each keeps its own record
  /// and its own history. The BLACKLIST is company-wide by contract — a
  /// blocked number that can order from the shop next door blocks nothing.
  storeId            String?   @map("store_id")
  fullName           String
  phone              String // Normalized digits only for duplicate search
  rawPhone           String // Display formatted
  altPhone           String?
  address            String
  city               String
  country            String    @default("EG")
  notes              String?
  totalOrders        Int       @default(0)
  confirmedOrders    Int       @default(0)
  deliveredOrders    Int       @default(0)
  cancelledOrders    Int       @default(0)
  totalPurchaseValue Float     @default(0.0)
  firstOrderDate     DateTime?
  lastOrderDate      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store                 Store?                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  orders                Order[]
  whatsappConversations WhatsAppConversation[]

  @@unique([companyId, storeId, phone])
  @@index([companyId, storeId])
  @@index([companyId, phone])
  @@map("customers")
}

model Order {
  id             String  @id @default(uuid())
  companyId      String
  orderNumber    String
  customerId     String
  /// The channel this order came through. The free-text `source` below is
  /// kept as it was written, so an order never loses where it said it came
  /// from when a channel is renamed or retired.
  channelId      String?
  /// The paid campaign that brought this order, when one did.
  ///
  /// Separate from `channelId`: a channel is the door (Facebook, WhatsApp,
  /// walk-in) and a campaign is one specific spend through it. Two Meta
  /// campaigns running at once are the same channel and different money,
  /// and telling them apart is the entire point of the screen.
  // No @map: this table is camelCase throughout, and matching the table
  // beats matching the newer convention.
  campaignId     String?
  /// mobile | tablet | desktop — for an order placed on a public page, the
  /// kind of device it came from. A class, never the raw user agent: a
  /// landing page promises no personal data. Null for every other door.
  deviceClass    String?
  productId      String
  offerId        String?
  quantity       Int     @default(1)
  sellingPrice   Float
  shippingCost   Float   @default(0.0)
  discountAmount Float   @default(0.0)
  totalAmount    Float
  currency       String  @default("USD")
  // Ownership model (Decision 1)
  // createdById = the staff account that ENTERED this order, whatever its
  // role. `moderatorId` only ever recorded a MODERATOR, so an order typed
  // by an agent or imported by a supervisor had no creator at all — the
  // fact survived only in activity rows. Nullable and never backfilled:
  // a public storefront order has no staff creator, and an order from
  // before this column exists has none to invent.
  createdById    String?

  // moderatorId = original MODERATOR who created/entered the order (semantic preserved)
  moderatorId               String?
  moderatorCommission       Float     @default(0.0)
  // assignedToId = employee currently assigned to work on the order
  assignedToId              String?
  assignedAt                DateTime?
  // claimedById = employee who officially claimed/signed responsibility
  claimedById               String?
  claimedAt                 DateTime?
  // currentOwnerId = employee currently responsible for operational handling
  currentOwnerId            String?
  // Editing lock (server-enforced expiration)
  lockedById                String?
  lockedAt                  DateTime?
  lockExpiresAt             DateTime?
  // Digital signature / claim
  signatureStatus           String    @default("UNSIGNED") // UNSIGNED, SIGNED
  signedById                String?
  signedAt                  DateTime?
  signatureNote             String?
  // Optimistic concurrency
  version                   Int       @default(1)
  estimatedCostOfGoods      Float     @default(0.0)
  productNameSnapshot       String?
  productImageSnapshot      String?
  status                    String    @default("NEW") // legacy combined status (kept for compatibility)
  confirmationStatus        String    @default("NEW") // NEW, IN_PROGRESS, NO_ANSWER, FOLLOW_UP_REQUIRED, POSTPONED, CONFIRMED, REJECTED, CANCELLED
  shippingStatus            String    @default("NOT_READY") // NOT_READY, READY_FOR_SHIPPING, PACKING, READY_FOR_PICKUP, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, FAILED_DELIVERY, RETURN_REQUESTED, RETURNED, CANCELLED
  settlementStatus          String    @default("NOT_APPLICABLE") // NOT_APPLICABLE, PENDING, PARTIALLY_SETTLED, SETTLED, REFUNDED, PARTIALLY_REFUNDED, CANCELLED, PENDING_COLLECTION, COLLECTED, UNSETTLED
  // Phase D1: confirmation workflow
  rejectionReason           String? // PRICE_TOO_HIGH, CUSTOMER_CHANGED_MIND, CUSTOMER_DOES_NOT_WANT_PRODUCT, DUPLICATE_ORDER, WRONG_NUMBER, FAKE_ORDER, OUT_OF_SERVICE_AREA, OTHER
  rejectionNote             String?
  confirmedById             String?
  // Phase D1: follow-up system (server-time authoritative)
  nextFollowUpAt            DateTime?
  followUpReason            String? // NO_ANSWER, CUSTOMER_REQUESTED_CALLBACK, POSTPONED, FAILED_CONFIRMATION, OTHER
  followUpStatus            String? // SCHEDULED, DUE, OVERDUE, COMPLETED, CANCELLED (SCHEDULED/COMPLETED stored; DUE/OVERDUE derived from nextFollowUpAt)
  followUpResolvedAt        DateTime?
  followUpResolvedById      String?
  // Phase D2: shipping & delivery
  deliveryProviderId        String?
  deliveryAssignedAt        DateTime?
  deliveryAssignedById      String?
  trackingNumber            String?
  shippingReference         String?
  deliveryFee               Float?
  shippingNote              String?
  shippingBatchId           String?
  shippedAt                 DateTime?
  outForDeliveryAt          DateTime?
  failedAt                  DateTime?
  returnedAt                DateTime?
  deliveryFailureReason     String? // CUSTOMER_NOT_AVAILABLE, PHONE_UNREACHABLE, WRONG_ADDRESS, CUSTOMER_REFUSED, ADDRESS_NOT_FOUND, AREA_NOT_SERVICED, CUSTOMER_REQUESTED_DELAY, OTHER
  deliveryNote              String?
  returnReason              String? // CUSTOMER_REFUSED, FAILED_DELIVERY, DAMAGED_PRODUCT, WRONG_PRODUCT, CUSTOMER_REQUEST, OTHER
  // Phase D3: financial snapshot (Decimal never floats for money)
  subtotal                  Decimal?  @db.Decimal(14, 3)
  discount                  Decimal?  @db.Decimal(14, 3)
  shippingRevenue           Decimal?  @db.Decimal(14, 3)
  totalRevenue              Decimal?  @db.Decimal(14, 3)
  productCost               Decimal?  @db.Decimal(14, 3)
  packagingCost             Decimal?  @db.Decimal(14, 3)
  advertisingCost           Decimal?  @db.Decimal(14, 3)
  otherCost                 Decimal?  @db.Decimal(14, 3)
  refundAmount              Decimal?  @db.Decimal(14, 3)
  grossProfit               Decimal?  @db.Decimal(14, 3)
  netProfit                 Decimal?  @db.Decimal(14, 3)
  financeFinalizedAt        DateTime?
  financeFinalizedById      String?
  source                    String    @default("Manual") // Facebook Ads, TikTok, Instagram, WhatsApp, Manual, Website, Landing Page
  /// ── WHERE AN ORDER THAT CAME THROUGH `/api/v1` CAME FROM ──
  ///
  /// Written only by the systems door (the `src/lib/v1` modules) and null on every
  /// order raised in this product's own screens. They are the media buyer's
  /// evidence: which ad a conversation started from, and when the customer
  /// touched it. Nothing here is read by pricing, by stock or by the order's
  /// state — removing the lot would change no money.
  ///
  /// `externalRef` is the OTHER system's own name for the order. It is not
  /// what makes a retry safe — `IdempotencyRecord` is — so it carries no
  /// unique index: two systems may legitimately use the same string, and a
  /// constraint here would make one of them fail at the door for a reason
  /// nobody could read.
  externalRef               String?
  /// The channel word the calling system used («whatsapp», «messenger»).
  ///
  /// NOT `channel`: that name is already this model's relation to
  /// `OrderChannel`, which is the company's own list of doors. This is the
  /// caller's word for its own transport, kept as it was sent.
  externalChannel           String?
  /// CODE | CTWA | REF — how the calling system decided which ad this was.
  adSourceType              String?
  adId                      String?
  /// The click id of a «click to WhatsApp» ad, ENCRYPTED at rest.
  ///
  /// It identifies one person's click on one ad. Encrypted with the same
  /// `encryptSecret` a courier password uses, and never returned by any
  /// endpoint — the same rule the owner set for an ad token: it reaches no
  /// model, and it does not reach a screen either.
  ctwaClidEnc               String?
  /// The short code the customer quoted («K7Q2») and when they quoted it.
  refCode                   String?
  refCodeAt                 DateTime?
  /// When the customer last touched the ad.
  touchAt                   DateTime?
  pageId                    String?
  /// The platform-scoped id of the person who wrote in, ENCRYPTED at rest —
  /// same reason as `ctwaClidEnc`.
  psidEnc                   String?
  wabaId                    String?
  /// The calling system's own handle for the conversation this came out of,
  /// so a reply can be traced back to the order without storing the chat.
  conversationRef           String?
  landingPageId             String?
  freeQuantity              Int       @default(0) // gift units from a landing-page offer (additive)
  internalNotes             String?
  customerNotes             String?
  postponedUntil            DateTime?
  /// Held back from today's shipment — NOT the confirmation postpone.
  /// `postponedUntil` means "call them back on Thursday" and belongs to the
  /// agent; this means "do not put it in a van yet" and belongs to whoever
  /// builds the shipment.
  shipHoldUntil             DateTime?
  shipHoldReason            String?
  // Stage 4: what the customer asked for, and how often they have asked.
  postponePreferredTime     String? // free text slot, e.g. "مساءً" or "18:00-20:00"
  postponeCount             Int       @default(0)
  confirmedAt               DateTime?
  deliveredAt               DateTime?
  // Geo context (Stage 1). Nullable until every order-creation path writes it.
  countryId                 String?
  storeId                   String?
  // Stage 3: courier-facing reference, generated for EVERY order (POS, landing
  // page, Telegram). Read-only once set; sent in the courier reference field.
  merchantRef               String?
  // Stage 5: the delivery region drives the fee table and the late threshold.
  regionId                  String?
  // The street address THIS order went to. The customer keeps only their
  // latest one, and the legacy import carries a separate address per order;
  // without this the older ones were lost. Null = read the customer's.
  deliveryAddress           String?
  // A manual fee override always carries a reason (written to the audit log).
  deliveryFeeOverrideReason String?
  // A courier may only be changed at shipment creation. Afterwards the
  // parcel is taken back and a REPLACEMENT order is raised, which re-enters
  // preparation and is assigned from scratch; these two link the pair.
  replacesOrderId           String?   @unique
  // Stage 9 — what the customer actually paid at the door. Set only on a
  // partial delivery, and it INCLUDES the full delivery fee: the courier
  // travelled whether or not every line was taken, so the fee is never
  // prorated. Null everywhere else, which is what lets settlement tell a
  // partial from a whole one.
  /// AND THE COLUMN HOLDS THREE DECIMALS BECAUSE THE DINAR HAS THREE.
  ///
  /// This was `Decimal(12, 2)` — along with twenty-five other money
  /// columns — while the product serves Jordan, whose JOD has a
  /// `minorUnit` of 3. PROVED IN POSTGRES ITSELF: `2.555::numeric(12,2)`
  /// is `2.56`, so five fils were lost on the way INTO the column, every
  /// time, silently.
  ///
  /// And this column is the worst place for it: it is the statement
  /// figure, the one that WINS over what was counted at the door. The
  /// screens were already right — `money-decimals.test.ts` holds every
  /// screen to the currency's own decimals — so a JOD figure was printed
  /// as `2.560` with three confident digits, the last of them invented by
  /// a rounding nobody chose.
  ///
  /// `a-fils-is-not-a-rounding-error.test.ts` now walks the schema and
  /// refuses a money column with fewer decimals than the widest currency
  /// the product serves — so the twenty-seventh cannot be added quietly.
  collectedAmount           Decimal?  @db.Decimal(14, 3)
  // A split order's parent. Children carry a suffixed number (SY-0044-A).
  parentOrderId             String?
  labelPrintedAt            DateTime?
  /// How many consecutive polls the courier had no record of this barcode.
  /// Reset to zero the moment a real status comes back. Three in a row and
  /// the system says "missing at the courier" out loud — once — instead of
  /// asking for ever and telling nobody.
  trackingMissCount         Int       @default(0) @map("tracking_miss_count")
  trackingMissingSince      DateTime? @map("tracking_missing_since")
  trackingMissingAlertedAt  DateTime? @map("tracking_missing_alerted_at")
  /// When the courier was last ASKED about this parcel (RV146). The status poll takes the parcels never asked, then the
  /// ones asked longest ago, sixty a sweep, so a restart no longer starts every courier again from the same first ones.
  /// Written only by raw SQL in `couriers/poll-stamp.ts`: a bookkeeping stamp must not move `updatedAt`, which the
  /// media buyer's hourly read pages by. Null = never asked. Not money, not a status.
  courierPolledAt           DateTime? @map("courier_polled_at")
  /// When this order was handed to the courier's API, set BEFORE the call.
  ///
  /// The claim, not the record: a second dispatcher finds it already set
  /// and leaves the parcel alone. Without it, two runs of the same batch
  /// both read `trackingNumber` as null, both created a parcel, and the
  /// second barcode overwrote the first — leaving a real parcel at the
  /// courier that nothing in here can name.
  ///
  /// It is NOT cleared when the courier does not answer in time. A request
  /// that timed out may well have created the parcel; clearing it would
  /// invite exactly the second waybill this prevents. Someone checks with
  /// the courier and either types the barcode in or releases the order.
  courierSendStartedAt      DateTime? @map("courier_send_started_at")
  // Snapshot of the offer's delivery policy: if ANY line includes delivery the
  // whole order does, and the fee is deducted from revenue instead of added.
  priceIncludesDelivery     Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country               Country?               @relation(fields: [countryId], references: [id], onDelete: Restrict)
  store                 Store?                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel               OrderChannel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaign              Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  conversionDeliveries  ConversionDelivery[]
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer                 Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  moderator             User?                  @relation("ModeratorOrders", fields: [moderatorId], references: [id], onDelete: SetNull)
  assignee              User?                  @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  claimer               User?                  @relation("OrderClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  owner                 User?                  @relation("OrderCurrentOwner", fields: [currentOwnerId], references: [id], onDelete: SetNull)
  lockHolder            User?                  @relation("OrderLockHolder", fields: [lockedById], references: [id], onDelete: SetNull)
  signer                User?                  @relation("OrderSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  deliveryAssigner      User?                  @relation("DeliveryAssignedBy", fields: [deliveryAssignedById], references: [id], onDelete: SetNull)
  deliveryProvider      DeliveryProvider?      @relation(fields: [deliveryProviderId], references: [id], onDelete: SetNull)
  shippingBatch         ShippingBatch?         @relation(fields: [shippingBatchId], references: [id], onDelete: SetNull)
  confirmer             User?                  @relation("OrderConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  followUpResolver      User?                  @relation("FollowUpResolvedBy", fields: [followUpResolvedById], references: [id], onDelete: SetNull)
  callLogs              CallLog[]
  landingPage           LandingPage?           @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  addOns                OrderAddOn[]
  activities            OrderActivity[]
  deliveryAttempts      DeliveryAttempt[]
  financialTransactions FinancialTransaction[]
  items                 OrderItem[]
  notes                 OrderNote[]
  commissions           CommissionEntry[]
  settlementMatches     SettlementMatch[]
  region                Region?                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  replaces              Order?                 @relation("OrderReplacement", fields: [replacesOrderId], references: [id], onDelete: SetNull)
  replacedBy            Order?                 @relation("OrderReplacement")
  parentOrder           Order?                 @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  splitChildren         Order[]                @relation("OrderSplit")
  returnReceipt         ReturnReceipt?
  changeRequests        OrderChangeRequest[]
  issues                OrderIssue[]
  claimHistory          OrderClaimHistory[]
  statusLogs            OrderStatusLog[]
  contactAttempts       OrderContactAttempt[]
  telegramMessages      TelegramMessage[]
  /// AT MOST ONE, AND A LIST ANYWAY.
  ///
  /// `ProductReview?` would be a one-to-one, and Prisma then demands
  /// `@unique` on `orderId` — a FULL unique index, which also constrains
  /// the manual rows that have no order and whose NULLs Postgres counts as
  /// distinct. The real rule is PARTIAL
  /// (`product_reviews_order_key`, named on ProductReview), so the schema
  /// says «many» and the database says «one». `oneRatingPerOrder` reads it.
  reviews               ProductReview[]

  @@unique([companyId, orderNumber])
  @@unique([companyId, merchantRef])
  @@index([companyId, createdAt]) // hot path: list ordering + prev/next navigation + analytics windows
  @@index([companyId, updatedAt]) // the media buyer's hourly read pages by updatedAt (/api/v1/orders/attribution)
  @@index([companyId, status])
  @@index([companyId, confirmationStatus, claimedById])
  @@index([companyId, nextFollowUpAt])
  @@index([companyId, shippingStatus])
  @@index([companyId, deliveryProviderId])
  @@index([companyId, trackingNumber])
  @@index([companyId, shippingBatchId])
  @@index([companyId, customerId])
  @@index([companyId, createdById])
  @@index([companyId, moderatorId])
  @@index([companyId, productId])
  @@index([companyId, assignedToId])
  @@index([companyId, claimedById])
  @@index([companyId, currentOwnerId])
  @@index([companyId, lockedById])
  @@index([companyId, confirmationStatus])
  @@index([companyId, settlementStatus])
  @@index([companyId, landingPageId])
  @@index([companyId, storeId, campaignId])
  @@index([lockedById, lockExpiresAt])
  @@index([storeId, createdAt])
  @@index([countryId])
  @@index([companyId, labelPrintedAt])
  @@index([companyId, courierSendStartedAt])
  @@index([regionId])
  /// «Which orders quoted a code?» — the media buyer's question, asked over
  /// a column that is null on nearly every row.
  @@index([companyId, refCode])
  @@map("orders")
}

model CallLog {
  id               String    @id @default(uuid())
  companyId        String
  orderId          String
  moderatorId      String
  callDate         DateTime  @default(now())
  result           String // NO_ANSWER, CONFIRMED, REJECTED, POSTPONED, WRONG_NUMBER, CALLBACK_REQUESTED
  notes            String?
  nextFollowUpDate DateTime?
  createdAt        DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  moderator User    @relation(fields: [moderatorId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId])
  @@index([moderatorId])
  @@map("call_logs")
}

model OrderActivity {
  id             String   @id @default(uuid())
  companyId      String
  orderId        String
  userId         String?
  action         String // ORDER_CREATED, CUSTOMER_UPDATED, MODERATOR_ASSIGNED, CALL_MADE, STATUS_CHANGED, ORDER_UPDATED, NOTE_ADDED, SHIPPING_UPDATED
  previousStatus String?
  newStatus      String?
  metadata       String? // JSON
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, orderId])
  @@map("order_activities")
}

model Expense {
  id          String   @id @default(uuid())
  companyId   String
  title       String
  category    String // MANUFACTURING, PACKAGING, SHIPPING, MARKETING, COMMISSION, SALARIES, OFFICE, OTHER
  amount      Float
  expenseDate DateTime @default(now())
  referenceId String? // batchId or orderId
  notes       String?
  /// The wallet the money actually left. Required for every new expense:
  /// money recorded as spent and absent from the wallet ledger makes the
  /// daily closing show a shortfall nobody can explain — and somebody then
  /// writes an explanation for an expense that was already recorded.
  ///
  /// Nullable only because the column is newer than the table.
  walletId    String?  @map("wallet_id")
  /// The movement this expense wrote, so the pair can never be half-made.
  movementId  String?  @map("movement_id")
  createdById String?
  createdAt   DateTime @default(now())
  /// WHICH STORE BORE THIS EXPENSE. Every new expense carries the store it was
  /// recorded in, and a store's profit subtracts its own expenses only.
  ///
  /// NULL = written before the column existed. A null row is read exactly as it
  /// was before (it counts against every store, the way it always did) until the
  /// owner runs scripts/backfills/20261029-expenses-get-their-store.sql — no
  /// migration fills it, so no store's profit moves on deploy.
  storeId     String?  @map("store_id")
  /// CANCELLED, NEVER DELETED. A cancelled expense stays on the list — marked —
  /// and leaves every profit figure. Set in the same transaction that returns its
  /// money to the wallet (src/lib/wallets.ts reverseMovement, src/lib/expense-void.ts).
  voidedAt    DateTime? @map("voided_at")
  voidReason  String?   @map("void_reason")
  voidedById  String?   @map("voided_by_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wallet  Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@index([companyId, category])
  @@index([walletId])
  @@index([companyId, storeId, expenseDate])
  @@map("expenses")
}

// One row per recipient (stage 17). The read flag belongs to one person,
// so a row shared by many cannot carry it — the first reader used to mark
// it read for everybody. Rows with userId null are LEGACY broadcasts,
// written before the fan-out existed; nothing creates them any more, and
// only confirmation.supervise holders still see them (they were meant for
// "managers/admins").
model Notification {
  id        String   @id @default(uuid())
  companyId String
  userId    String? // the recipient; null only on legacy broadcasts
  // The store the news is about. Null = company-wide news (a wallet with no
  // store) or a legacy row. The bell shows the selected store's rows only.
  storeId   String?
  title     String
  message   String
  type      String // ORDER_NEW, SYSTEM_ALERT, POSTPONED_DUE, RETURNS_NOT_RECEIVED, CLOSING_DUE, …
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cascade, not cleanup code in the delete route: a user can be hard-
  // deleted (PATCH /api/users/:id action=delete) and a notification
  // addressed to nobody is readable by nobody. The constraint covers every
  // delete path, including ones not written yet.
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, isRead])
  @@index([storeId, type, createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  companyId    String
  userId       String?
  action       String
  entity       String
  entityId     String
  previousData String? // JSON
  newData      String? // JSON
  ipAddress    String?
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@map("audit_logs")
}

model AiDailySummary {
  id              String   @id @default(uuid())
  companyId       String
  date            String // YYYY-MM-DD
  summaryText     String
  metricsJson     String // JSON string of all KPI counts and calculations
  observations    String?
  risks           String?
  recommendations String?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("ai_daily_summaries")
}

// Order Claim / Signature — history never overwrites ownership events
// ──────────────────────────────────────────────────────────────────────
// PERMISSION ENGINE — Roles, RolePermissions, User overrides, Categories
// Additive-only. Legacy `User.role` string is kept for backward compatibility.
// ──────────────────────────────────────────────────────────────────────

model Role {
  id        String  @id @default(uuid())
  companyId String? // null = system-wide role template
  name      String
  isSystem  Boolean @default(false)

  /// THE LOOK A NEW PERSON IN THIS ROLE OPENS ON — and nothing more.
  ///
  /// The owner sets one for a role; the moment that person picks a theme of
  /// their own, `users.system_theme` wins and this stops being consulted
  /// for them. The same shape as the menu arrangement in
  /// `nav_arrangements`: a BASE for the role, overridden per person.
  ///
  /// Null = the product's default, which is what every role has today.
  systemTheme String?  @map("system_theme")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  defaults    RolePermissionDefault[]
  users       User[]
  navBase     NavArrangement[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model NavArrangement {
  id        String @id @default(uuid())
  companyId String

  /// THE OWNER OF THIS ARRANGEMENT — exactly one of the two.
  ///
  /// A row with `roleId` is the BASE the owner sets for a role; a row with
  /// `userId` is one person's own adjustment on top of it. Both in one
  /// table because they are the same thing — a stored opinion about the
  /// same menu — and because resolving them means reading both at once.
  ///
  /// Two PARTIAL unique indexes hold «one row per owner»; they live in the
  /// migration, not here, because Prisma cannot express a WHERE on an
  /// index. Six other indexes in this schema are the same way.
  roleId String?
  userId String?

  /// WHICH SURFACE THIS OPINION IS ABOUT — `nav`, `view:orders`, …
  ///
  /// NULL reads as `nav`, which is what every row written before this
  /// column existed is. Nullable rather than defaulted on purpose: a
  /// default would have written a value into every existing row, and
  /// those rows already mean the menu.
  surface String?

  /// `{ order: string[], hidden: string[], pinned: string[] }` — paths.
  /// JSON in a text column, read defensively: a menu is the one thing that
  /// must never fail to render. See src/lib/nav-arrangement.ts.
  layout String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// A deleted role takes its base with it, and its people fall back to the
  /// registry — the edge case the brief names, enforced by the database
  /// rather than by a cleanup job nobody runs.
  role    Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ── TWO PARTIAL UNIQUE INDEXES THE SCHEMA CANNOT EXPRESS ──
  ///
  /// `nav_arrangements_role_surface_key`
  ///     UNIQUE (companyId, roleId, COALESCE(surface,'nav')) WHERE roleId IS NOT NULL
  /// `nav_arrangements_user_surface_key`
  ///     UNIQUE (userId, COALESCE(surface,'nav'))            WHERE userId IS NOT NULL
  ///
  /// The surface is part of the key: without it «one base per role» would
  /// mean one for the whole product, so publishing a dashboard arrangement
  /// would overwrite that role's menu. And `COALESCE(…,'nav')` because two
  /// NULLs do not collide in a unique index — the rows written before the
  /// column existed would otherwise stop being covered by the rule they
  /// were created under.
  ///
  /// `@@unique([companyId, roleId])` would let a second row in whenever
  /// `roleId` is NULL, because NULLs do not collide — so every personal
  /// override would satisfy it and the table would collect a row per save.
  /// The WHERE is what makes each one mean «one base per role» and «one
  /// override per person». Both live in
  /// `20261015190000_nav_arrangement/migration.sql`, and they are named
  /// here because `pg_indexes` and not this file is the answer to «what
  /// does the database actually enforce» — which is a thing worth being
  /// able to read in one place.

  @@index([companyId, roleId])
  @@index([companyId, userId])
  @@index([companyId, surface])
  @@map("nav_arrangements")
}

model RolePermission {
  id         String   @id @default(uuid())
  roleId     String
  permission String // key from the code-defined permission catalog
  scope      String   @default("ALL_COMPANY") // ALL_COMPANY | OWN | ASSIGNED | CATEGORY | SPECIFIC
  scopeIds   Json? // categoryIds / productIds when scope is CATEGORY / SPECIFIC
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permissions")
}

/// The matrix a role was issued with — what "restore defaults" returns to.
/// Written once when the role is created (and seeded from the system
/// templates for the roles that predate this table); never touched by an
/// edit, which is the whole point: the editable rows cannot also be the
/// record of what they started as.
model RolePermissionDefault {
  id         String   @id @default(uuid())
  roleId     String
  permission String
  scope      String   @default("ALL_COMPANY")
  scopeIds   Json?
  createdAt  DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
  @@index([roleId])
  @@map("role_permission_defaults")
}

model UserPermission {
  id          String   @id @default(uuid())
  userId      String
  permission  String
  effect      String // ALLOW | DENY
  scope       String?
  scopeIds    Json?
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("UserPermissionGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, permission])
  @@index([userId])
  @@map("user_permissions")
}

model Category {
  id              String   @id @default(uuid())
  companyId       String
  name            String
  nameEn          String?
  /// A readable address for this kind of thing. Unique per company,
  /// because the category table is company-wide — see the note in
  /// `storefrontCatalog` on why there is no per-store copy of it.
  slug            String?
  /// THE QUESTIONS THIS KIND OF THING IS DESCRIBED BY, as JSON.
  ///
  /// «مناسب لـ» and «المكوّنات» are right for a remedy and wrong for a
  /// shirt, which needs «المقاس» and «الخامة» — so the questions belong to
  /// the category and the answers to the product. A fixed set of columns
  /// would be wrong for the sixth kind of thing a shop starts selling.
  ///
  /// See src/lib/product-attributes.ts, including why this is JSON and not
  /// two more tables.
  attributeSchema String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, slug])
  @@map("categories")
}

model OrderClaimHistory {
  id        String   @id @default(uuid())
  companyId String
  orderId   String
  userId    String
  action    String // CLAIMED, RELEASED, TRANSFERRED, OVERRIDDEN, UNLOCKED
  reason    String?
  metadata  String? // JSON snapshot (previousOwner, newOwner, performedBy...)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([companyId, userId])
  @@map("order_claim_history")
}

// Order status audit separate log per status category
model OrderStatusLog {
  id            String   @id @default(uuid())
  companyId     String
  orderId       String
  statusType    String // CONFIRMATION, SHIPPING, SETTLEMENT, LEGACY
  previousValue String?
  newValue      String?
  changedById   String
  changedByRole String
  note          String?
  createdAt     DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer User  @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([companyId, statusType])
  @@map("order_status_logs")
}

// Phase D1: Customer contact attempt history append-only, never overwritten
model OrderContactAttempt {
  id             String    @id @default(uuid())
  companyId      String
  orderId        String
  employeeId     String
  employeeRole   String
  attemptNumber  Int
  contactMethod  String // PHONE, WHATSAPP, SMS, OTHER
  result         String // ANSWERED, NO_ANSWER, BUSY, WRONG_NUMBER, CALLBACK_REQUESTED, CONFIRMED, REJECTED, OTHER
  note           String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employee User  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([orderId, attemptNumber])
  @@index([companyId, orderId, createdAt])
  @@index([companyId, employeeId])
  @@map("order_contact_attempts")
}

// Phase D2: Delivery providers (per company)
model DeliveryProvider {
  id                     String    @id @default(uuid())
  companyId              String
  /// Which store this courier belongs to. NULL = every store in the company,
  /// which is what every row meant before stores had their own couriers.
  /// A separate store is a separate business here: its own account with the
  /// courier, its own fees, its own statements.
  storeId                String?   @map("store_id")
  name                   String
  /// Unique within the company, not across the platform: "BASHA" is a name
  /// this company uses, not one it takes from everybody else.
  code                   String
  // COMPANY = a shipping company with its own pipeline and statements.
  // AGENT   = a مندوب: immediate delivery, settled by hand, and the only
  //           party an order may be moved away from without a replacement.
  kind                   String    @default("COMPANY")
  phone                  String?
  email                  String?
  address                String?
  isActive               Boolean   @default(true)
  apiEnabled             Boolean   @default(false)
  apiBaseUrl             String?
  // Which integration this courier runs on. A courier is not a platform:
  // Basha Delivery ships through LogesTechs, and another courier could ship
  // through the same platform under a different account. So the adapter is
  // named here, and the account's own ids live in apiConfig.
  adapterCode            String?
  // Per-courier settings for that adapter — their companyId, service and
  // vehicle type ids. Not secret: these appear in every API response.
  apiConfig              Json?
  // The account's login, encrypted at rest (AES-256-GCM, key in the
  // environment only). A courier password cannot be hashed — we have to
  // send it on every call — so it is encrypted instead, and a stolen
  // database dump is not a stolen account. NEVER returned by any endpoint:
  // screens are told that credentials exist, never what they are.
  apiCredentials         String?
  credentialsUpdatedAt   DateTime?
  credentialsUpdatedById String?
  // A courier that pushes statuses instead of us polling for them. We keep
  // the SHA-256 of the token only: the endpoint hashes what it is handed and
  // finds the provider by that, so a database dump yields no working URL.
  // The token itself is shown once, when it is generated.
  webhookSecretHash      String?   @unique @map("webhook_secret_hash")
  webhookSecretSetAt     DateTime? @map("webhook_secret_set_at")
  webhookLastSeenAt      DateTime? @map("webhook_last_seen_at")
  store                  Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders   Order[]
  batches  ShippingBatch[]
  attempts DeliveryAttempt[]
  fees     DeliveryFee[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, storeId])
  @@map("delivery_providers")
}

// Phase D2: Shipping batches (group orders per provider)
model ShippingBatch {
  id                 String    @id @default(uuid())
  companyId          String
  batchNumber        String
  deliveryProviderId String?
  status             String    @default("READY") // READY, SHIPPED, CLOSED
  createdById        String
  createdAt          DateTime  @default(now())
  shippedAt          DateTime?
  notes              String?

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider DeliveryProvider? @relation(fields: [deliveryProviderId], references: [id], onDelete: SetNull)
  creator  User              @relation("ShippingBatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  orders   Order[]
  // Geo context (Stage 2): a batch only holds orders of one store.
  storeId  String?
  store    Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([companyId, batchNumber])
  @@index([companyId, status])
  @@index([storeId, status])
  @@map("shipping_batches")
}

// Phase D2: Delivery attempt history append-only
model DeliveryAttempt {
  id                 String   @id @default(uuid())
  companyId          String
  orderId            String
  deliveryProviderId String?
  deliveryAgentId    String?
  attemptNumber      Int
  result             String // DELIVERED, FAILED, CUSTOMER_UNAVAILABLE, CUSTOMER_REFUSED, RESCHEDULED, OTHER
  failureReason      String? // structured reason when FAILED
  note               String?
  createdAt          DateTime @default(now())

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider DeliveryProvider? @relation(fields: [deliveryProviderId], references: [id], onDelete: SetNull)
  agent    User?             @relation("DeliveryAttemptAgent", fields: [deliveryAgentId], references: [id], onDelete: SetNull)

  @@unique([orderId, attemptNumber])
  @@index([companyId, orderId, createdAt])
  @@index([companyId, deliveryProviderId])
  @@map("delivery_attempts")
}

// ──────────────────────────────────────────────────────────────────────
// CRM MODULE — Contacts, Companies, Leads, Deals, Tasks, Activities, Notes, Invoices
// ──────────────────────────────────────────────────────────────────────

// Phase D3: Financial transactions append-only audit-grade money records
model FinancialTransaction {
  id          String   @id @default(uuid())
  companyId   String
  orderId     String?
  type        String // REVENUE, REFUND, EXPENSE, COMMISSION, SETTLEMENT, ADJUSTMENT
  amount      Decimal  @db.Decimal(14, 3)
  currency    String   @default("USD")
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor   User    @relation("FinanceTransactionActor", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@index([orderId])
  @@map("financial_transactions")
}

// ─── LANDING PAGES (additive) ───
// Public marketing pages that generate real CRM orders.
// slug is unique per company; htmlContent is stored server-side (never client-trusted).
model LandingPage {
  id                 String    @id @default(uuid())
  companyId          String
  name               String
  slug               String
  htmlContent        String?   @db.Text
  cssContent         String?   @db.Text // custom CSS from the visual editor (sanitized server-side)
  pageSettings       String? // JSON: { width, maxWidth, background, direction, fontFamily } — additive base styles
  // How this page is authored. 'BLOCKS' = themed section builder (default for
  // new pages); 'HTML' = the raw upload, kept as an alternative. NULL reads
  // as 'HTML', which is what every page predating the builder is.
  builderMode        String? // 'BLOCKS' | 'HTML'
  theme              String? // JSON: { accent, mood, font, corners } — one colour, palette derived
  sections           String?   @db.Text // JSON: ordered LandingSection[]
  /// THE PAGE AS THE SELLER IS EDITING IT — one blob, not six columns.
  ///
  /// Everything above is what a VISITOR reads. Until this column existed the
  /// editor wrote those directly, so «حفظ كمسودة» on a published page put a
  /// half-finished headline in front of every visitor the advert was sending.
  ///
  /// One blob because the editor saves html, css, settings, builderMode,
  /// theme and sections in ONE act (`contentPayload()`) and publishing
  /// promotes that one act; six draft columns would be six ways for half an
  /// act to go live. The store's home page and theme have a column each
  /// because they are two things a seller edits separately — this is not.
  contentDraft       String?   @db.Text
  /// What the live columns held before the last publish — ONE step back, not
  /// a history. A seller who regrets a publish wants what they had a minute
  /// ago, in one press; a version list is a different feature.
  contentPrevious    String?   @db.Text
  contentPublishedAt DateTime?
  metaPixelId        String? // Meta/Facebook Pixel ID (digits only, validated server-side)
  metaPixelEnabled   Boolean   @default(false) // false/empty → no Pixel script is ever loaded
  productId          String?
  // A hostname of the seller's own, pointed at this app in DNS. Lowercase,
  // and unique across every company: a hostname belongs to whoever proved
  // it, and two claims on one would make the proxy's answer depend on which
  // row it happened to read first.
  /// UNIQUE across every company, held by `landing_pages_domain_key` —
  /// partial (WHERE domain IS NOT NULL), written in the migration. A hostname
  /// belongs to whoever proved it.
  domain             String?
  domainVerifiedAt   DateTime?
  isPublished        Boolean   @default(false)
  /// Listed in the store's own front by a `catalog` block. Belonging to a
  /// store is not the same as being shown in it: a campaign page is meant to
  /// be reachable by its link and nowhere else, and listing every page a
  /// store owns would put the half-finished ones in the shop window.
  showInStore        Boolean   @default(false)
  viewsCount         Int       @default(0) // view = one successful public page render (no PII)
  ordersCount        Int       @default(0)
  upsellAddsCount    Int       @default(0) // recommendation add-ons accepted after order
  upsellRevenue      Float     @default(0) // revenue of accepted add-ons (server-side computed)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product         Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  creator         User?                       @relation("LandingPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders          Order[]
  campaigns       Campaign[]
  recommendations LandingPageRecommendation[]
  addOns          OrderAddOn[]
  views           LandingPageView[]
  browserViews    LandingPageBrowserView[]
  // Geo context (Stage 2): orders from this page land in this store.
  storeId         String?
  store           Store?                      @relation("StorePages", fields: [storeId], references: [id], onDelete: Restrict)
  /// The Single Product store whose front this page is, if any.
  frontOf         Store?                      @relation("StoreFrontPage")

  @@unique([companyId, slug])
  @@unique([domain])
  @@index([companyId])
  @@index([companyId, isPublished])
  @@index([storeId])
  @@index([storeId, showInStore])
  @@map("landing_pages")
}

// ─── LANDING PAGE RECOMMENDATIONS (additive) ───
// Products suggested on the post-order success screen (upsells).
model LandingPageRecommendation {
  id            String   @id @default(uuid())
  landingPageId String
  productId     String
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  /// One short line the seller writes for this suggestion on this page.
  /// Null: the screen reads the start of the product's description instead.
  blurb         String?  @db.VarChar(140)
  createdAt     DateTime @default(now())

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, productId])
  @@index([landingPageId, isActive, sortOrder])
  @@map("landing_page_recommendations")
}

// ─── ORDER ADD-ONS (additive) ───
// Upsell products added to an EXISTING order from the landing page success
// screen. Uses the same Order model — no duplicate order system.
model OrderAddOn {
  id            String   @id @default(uuid())
  companyId     String
  orderId       String
  productId     String
  landingPageId String?
  productName   String // snapshot
  quantity      Int      @default(1)
  price         Float // unit price from DB at add time
  total         Float // quantity * price (server-side)
  /// THE POST-ORDER OFFER THIS ADDITION CAME FROM, when it came from one.
  ///
  /// NULL is every row written before the post-order offer existed, and
  /// every row the recommendation list still writes — so the column also
  /// answers «has this order already taken the offer after the order?»,
  /// which is how «once only» is a fact on the row instead of a hope.
  ///
  /// Not a foreign key on purpose, the reason `SystemSetting.updatedById`
  /// gives: an offer an order was placed on is RETIRED rather than deleted
  /// (`status: INACTIVE`), and this record of what was sold must survive
  /// whatever later happens to the configuration it was sold from.
  offerId       String?
  /// Units this add-on holds on the shelf — the same meaning as `OrderItem.reservedQty`. Reserved with the order's
  /// lines at confirmation, released with them, cleared when the goods leave (`consumeOrderStock`).
  reservedQty   Int      @default(0)
  createdAt     DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  landingPage LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([companyId, orderId])
  @@map("order_add_ons")
}

// ─── WHATSAPP BUSINESS CLOUD API (additive) ───
// Official Meta Cloud API only — no unofficial bridges. One shared business
// number per company; employees share a single Inbox. Access tokens are
// server-only (env var or AES-256-GCM encrypted at rest) and are NEVER
// returned by any API or exposed to the client.
model WhatsAppConnection {
  id                   String    @id @default(uuid())
  companyId            String
  wabaId               String // WhatsApp Business Account ID
  phoneNumberId        String // Phone Number ID (Meta)
  phoneNumber          String? // display phone, e.g. +20 10 xxxx
  displayName          String?
  status               String    @default("NEEDS_SETUP") // CONNECTED, NEEDS_SETUP, DISCONNECTED
  accessTokenEncrypted String? // AES-256-GCM encrypted token (fallback when env token absent)
  lastWebhookAt        DateTime?
  lastMessageAt        DateTime?
  lastError            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  company       Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations WhatsAppConversation[]
  messages      WhatsAppMessage[]

  // One number per company today; the schema allows more later.
  @@unique([companyId, phoneNumberId])
  @@index([companyId, status])
  @@map("whatsapp_connections")
}

// Customer-facing conversation (a chat thread with one phone number).
// Statuses OPEN/CLOSED now; extensible to PENDING/ARCHIVED later.
model WhatsAppConversation {
  id                 String    @id @default(uuid())
  companyId          String
  connectionId       String
  customerId         String?
  customerPhone      String // WhatsApp wa_id (digits only)
  customerName       String?
  status             String    @default("OPEN") // OPEN, CLOSED (PENDING/ARCHIVED reserved for later)
  assignedUserId     String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  unreadCount        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo User?              @relation("WhatsAppAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages   WhatsAppMessage[]

  @@unique([companyId, connectionId, customerPhone])
  @@index([companyId, status, lastMessageAt])
  @@index([companyId, assignedUserId])
  @@index([companyId, customerId])
  @@map("whatsapp_conversations")
}

// Individual WhatsApp message. externalMessageId (Meta wamid) is unique so
// duplicate webhook deliveries can never create duplicate messages.
model WhatsAppMessage {
  id                String   @id @default(uuid())
  companyId         String
  conversationId    String
  connectionId      String
  externalMessageId String
  direction         String // INBOUND, OUTBOUND
  messageType       String   @default("TEXT") // TEXT (IMAGE/VIDEO/AUDIO/DOCUMENT/TEMPLATE reserved)
  text              String?
  status            String   @default("RECEIVED") // RECEIVED, SENT, DELIVERED, READ, FAILED
  senderPhone       String?
  recipientPhone    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connection   WhatsAppConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([externalMessageId])
  @@index([companyId, conversationId, createdAt])
  @@index([companyId, status])
  @@map("whatsapp_messages")
}

// ─── Telegram Order Ingestion (additive) ───
// A TelegramSource links one Telegram chat (group/supergroup) — or one forum
// topic inside it — to a company. topicId = null means the WHOLE chat is
// mapped; a numeric topicId maps a single forum topic. A chat can never be
// bound to two companies: `telegram_sources_chatId_group_unique` (chatId
// WHERE topicId IS NULL) and `telegram_sources_chatId_topic_unique` (chatId,
// topicId WHERE topicId IS NOT NULL), both partial and both in the migration
// because Prisma cannot write a partial unique index. Named rather than
// alluded to — an index a reader cannot find is an index they re-create.
model TelegramSource {
  id            String    @id @default(uuid())
  companyId     String
  chatId        String // Telegram chat id (e.g. "-1001234567890")
  chatType      String // group, supergroup, channel
  chatTitle     String?
  topicId       Int? // message_thread_id when mapping a single topic
  topicName     String?
  isActive      Boolean   @default(true)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages TelegramMessage[]
  // Geo context (Stage 2): orders parsed from this chat land in this store.
  storeId  String?
  store    Store?            @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([companyId, chatId, topicId])
  @@index([chatId])
  @@index([companyId, isActive])
  @@map("telegram_sources")
}

// Every accepted webhook message is stored once (unique per tenant +
// chat + message id) — the DB constraint is the idempotency source of
// truth for duplicate Telegram webhook deliveries.
model TelegramMessage {
  id               String    @id @default(uuid())
  companyId        String
  sourceId         String?
  chatId           String
  messageId        String // Telegram message_id (per chat)
  threadId         Int? // message_thread_id when the chat is a forum
  threadName       String?
  senderUserId     String?
  senderUsername   String?
  senderName       String?
  text             String?
  messageType      String    @default("TEXT") // TEXT, PHOTO, ... (reserved)
  processingStatus String    @default("PENDING") // PENDING, PROCESSED, IGNORED, NEEDS_REVIEW, FAILED
  reviewReason     String? // PRODUCT_NOT_FOUND, AMBIGUOUS_PRODUCT, INVALID_PHONE, MISSING_CUSTOMER_NAME, MISSING_ADDRESS, INVALID_QUANTITY, ...
  pageName         String? // اسم الصفحة التجارية داخل الرسالة (المصدر) — غير مرتبط بمجموعة تيليجرام
  orderId          String?
  internalError    String? // safe internal error code only (never secrets/stacks)
  createdAt        DateTime  @default(now())
  processedAt      DateTime?

  company Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  TelegramSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([companyId, chatId, messageId])
  @@index([companyId, processingStatus, createdAt])
  @@index([companyId, sourceId])
  @@index([orderId])
  @@map("telegram_messages")
}

// ─── GEO CONTEXT (Stage 1, additive) ───
// Company -> Country -> Store. A store inherits currency, minor unit,
// regions, work hours, weekend days, order prefix and allowNegativeStock
// from its country; none of these are stored on Store.
model Country {
  id                 String   @id @default(uuid())
  companyId          String
  code               String // ISO 3166-1 alpha-2 (e.g. SY, JO); "ZZ" = not yet set
  name               String
  currencyCode       String // ISO 4217 (e.g. SYP, JOD)
  minorUnit          Int      @default(2) // decimal places for this currency
  workHoursStart     String   @default("09:00") // HH:mm, country-local
  workHoursEnd       String   @default("17:00")
  weekendDays        Int[]    @default([5]) // 0 = Sunday ... 6 = Saturday
  timezone           String   @default("Asia/Damascus") // IANA
  orderPrefix        String   @default("ORD")
  allowNegativeStock Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trackingPixels TrackingPixel[]
  regions        Region[]
  stores         Store[]
  deliveryFees   DeliveryFee[]
  wallets        Wallet[]
  orders         Order[]
  access         UserCountryAccess[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("countries")
}

// Governorate / region inside a country. Replaces the hard-coded list in
// src/lib/locations/syria.ts once every caller reads from here.
model Region {
  id        String   @id @default(uuid())
  countryId String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  country      Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  orders       Order[]
  deliveryFees DeliveryFee[]

  @@unique([countryId, name])
  @@map("regions")
}

/// Where orders come from, as the shop defines them.
///
/// The order's `source` was free text, so the same channel arrived spelled
/// three ways and the filter offered a list written into a screen while the
/// orders in front of it carried something else entirely. A channel is a row
/// now: named once, picked from a list, and countable.
///
/// `kind` is the platform behind the name — several channels can share one
/// ("تيكتوك - صفحة الكريم" and "تيكتوك - صفحة القطرة" are both TIKTOK), which
/// is what makes per-platform reporting possible without losing the detail.
model OrderChannel {
  id        String   @id @default(uuid())
  companyId String
  name      String
  /// LANDING_PAGE | FACEBOOK | INSTAGRAM | TIKTOK | WHATSAPP | TELEGRAM |
  /// PHONE | SHEET | WEBSITE | OTHER
  kind      String   @default("OTHER")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("order_channels")
}

model Store {
  id                    String       @id @default(uuid())
  companyId             String
  countryId             String
  name                  String
  slug                  String
  logo                  String?
  /// The icon in the browser tab of the store's public pages. Set beside the
  /// logo, in the store's settings; the logo stands in when there is none.
  favicon               String?
  status                String       @default("ACTIVE") // ACTIVE | PAUSED
  type                  String       @default("MULTI_PRODUCT") // MULTI_PRODUCT | SINGLE_PRODUCT
  /// A TEST BENCH, NOT A SHOP. «منتج تيست — بيئةٌ منعزلة … أرقامٌ لا تدخل
  /// أيَّ حسبة».
  ///
  /// Measured before this was chosen: 253 queries in this product already
  /// filter by `storeId` and exclude a test store FOR FREE, against 31 that
  /// are company-wide and touch money. A flag on the PRODUCT would inherit
  /// none of the 253 and would have to defend all 284.
  ///
  /// And a second COMPANY — perfect isolation, needing no exclusion anywhere
  /// — was refused for the requirement that put this here: «إنشاءُ منتج من
  /// DNA منتجاتك الناجحة» means READING the real products, and a
  /// cross-company read is the one thing this system refuses everywhere.
  ///
  /// It hides nothing. Categories, couriers, regions and settings are the
  /// company's and stay shared — a bench with its own courier list tests
  /// nothing. What it marks is the boundary for FIGURES, and
  /// `src/lib/test-store.ts` is the one place that says which.
  ///
  /// A bench may never be public: `stores_test_bench_is_not_public` refuses
  /// `isTest` beside `storefrontEnabled` at the database.
  isTest                Boolean      @default(false) @map("is_test")
  /// Whether the advertised price already contains the delivery fee.
  /// A shop-wide pricing policy, not a per-offer one: it used to live only
  /// on the offer, so a direct order on a delivery-inclusive store was
  /// priced as price + fee and asked the customer for money the seller had
  /// never advertised. An offer may still override it.
  priceIncludesDelivery Boolean      @default(false)
  // ─── The store's public face ───
  // A store was an internal boundary only. These give it a storefront,
  // reusing the landing page's theme engine rather than growing a second
  // one: the same accent colour, the same derived palette, the same CSS.
  storefrontEnabled     Boolean      @default(false)
  theme                 String? // JSON: { accent, mood, font, corners }
  tagline               String?
  about                 String?      @db.Text
  supportPhone          String?
  /// A hostname of the seller's own. Unique across stores, and checked
  /// against landing page domains too — the proxy must never find two
  /// answers for one host.
  /// UNIQUE across every company, held by `stores_domain_key` — partial
  /// (WHERE domain IS NOT NULL), written in the migration.
  domain                String?
  /// What language the shop's public pages are written in. The direction
  /// (rtl/ltr) is DERIVED from it, never stored beside it: two fields that
  /// can disagree will, and «العربية · LTR» is not a thing anybody meant.
  /// NOT translation — see src/lib/store-languages.ts.
  language              String       @default("ar")
  /// The shop's HOME PAGE, as LandingSection[] JSON — the same shape, the
  /// same block library and the same renderer as a landing page. There is
  /// one page builder in this system and this is it; a second one would be
  /// two sets of blocks to keep in step.
  ///
  /// Two columns because save, preview and publish are three separate acts:
  /// the seller saves and previews the DRAFT as often as they like, and only
  /// publishing copies it to LIVE, which is the only one a shopper sees.
  /// Pairs of words this shop treats as the same thing, as JSON —
  /// «طنين» and «صفير الأذن» are one complaint in two people's words, and
  /// only whoever sells the remedy knows that. A list we shipped would be
  /// wrong for the next shop. See src/lib/store-search.ts.
  searchSynonyms        String?      @db.Text
  homeDraft             String?      @db.Text
  homeLive              String?      @db.Text
  homePublishedAt       DateTime?
  /// What `homeLive` was before the last publish — one step back, not a history.
  homePrevious          String?      @db.Text
  /// THE LOOK, AS THE SELLER IS EDITING IT.
  ///
  /// `theme` is what every live page paints from. Until this column
  /// existed every save repainted the shop the instant it was pressed,
  /// while the home page beside it had had a draft, a publish and a
  /// confirmation since the day it was written. Same three columns, same
  /// names, same meaning — a second pattern for the same idea is how the
  /// two come to disagree.
  themeDraft            String?      @db.Text
  themePublishedAt      DateTime?
  /// What `theme` was before the last publish.
  themePrevious         String?      @db.Text
  /// When this store's domain last passed BOTH checks: a TXT token only this
  /// installation can compute (ownership) and DNS actually resolving here
  /// (routing). Null means never — a badge is never set by a button.
  domainVerifiedAt      DateTime?
  /// The last check's result as JSON (see src/lib/domain-verify.ts). Kept so
  /// the screen can say WHY it is not verified without re-querying DNS on
  /// every render.
  domainCheck           String?      @db.Text
  /// A Single Product store's front: one of its own landing pages, which its
  /// link and its domain render — every block, template, pixel and upsell
  /// the page has. The store is the address; the page is the shop. Null
  /// until the seller picks one. A page fronts one store at most.
  landingPageId         String?      @unique
  landingPage           LandingPage? @relation("StoreFrontPage", fields: [landingPageId], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  country           Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  orders            Order[]
  access            UserStoreAccess[]
  landingPages      LandingPage[]      @relation("StorePages")
  telegramSources   TelegramSource[]
  shippingBatches   ShippingBatch[]
  couriers          DeliveryProvider[]
  fonts             StoreFont[]
  campaigns         Campaign[]
  adAccounts        AdAccount[]
  trackingPixels    TrackingPixel[]
  wallets           Wallet[]
  expenses          Expense[]
  products          Product[]
  customers         Customer[]
  notifications     Notification[]
  /// The one signed physical count of stock this store started from.
  stockOpeningCount StockOpeningCount?
  pages             StorePage[]
  menus             StoreMenu[]
  redirects         StoreRedirect[]
  productReviews    ProductReview[]

  @@unique([companyId, slug])
  @@unique([domain])
  @@index([countryId, status])
  @@map("stores")
}

/// A page of the shop's own words: who we are, the terms, the privacy
/// policy, how returns work, how to reach us.
///
/// NOT a landing page. A landing page sells one product and carries offers,
/// a pixel and an order form; this is text a shop must have and a customer
/// may want. The three legal ones are created with every store, because
/// their absence stops an advertising account's review — a shop cannot
/// discover on the day of the campaign that it has no privacy policy.
/// An old address that still arrives.
///
/// A seller renames a landing page's slug while an ad is running on the old
/// one; every already-paid click then lands on a 404. A rename SUGGESTS one
/// of these (suggested = true) and the seller accepts or dismisses it —
/// because a slug changed to get AWAY from a campaign must not forward.
model StoreRedirect {
  id        String   @id @default(uuid())
  companyId String
  storeId   String
  /// The old path, e.g. /lp/winter-offer. No query, no fragment.
  from      String
  /// A path here, or an absolute http(s) URL.
  to        String
  /// 301 (moved for good, cached hard) or 302 (for now). Default 302.
  kind      Int      @default(302)
  /// Best-effort: counted without blocking the customer's redirect.
  hits      Int      @default(0)
  isActive  Boolean  @default(true)
  /// Raised by a slug change and not yet decided. Suggestions do not forward.
  suggested Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, from])
  @@index([isActive, suggested])
  @@map("store_redirects")
}

/// One of a shop's five menus: the header bar, the main menu, the footer,
/// "about", and the policies.
///
/// The items are JSON because a menu is read whole, written whole and
/// ordered by hand — never queried by item. A table would buy nothing and
/// cost a join on every public page render. The landing page's sections are
/// stored the same way for the same reason.
model StoreMenu {
  id        String   @id @default(uuid())
  companyId String
  storeId   String
  /// HEADER | MAIN | FOOTER | ABOUT | POLICIES
  key       String
  /// JSON: [{ label, href, visible }] — see src/lib/store-menus.ts.
  items     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, key])
  @@map("store_menus")
}

model StorePage {
  id          String   @id @default(uuid())
  companyId   String
  storeId     String
  /// Its address under the shop: /s/<store>/pages/<slug>.
  slug        String
  title       String
  /// Plain text, paragraph per line. Never markup: it is rendered as text.
  body        String   @db.Text
  /// ABOUT | TERMS | PRIVACY | REFUND | CONTACT | CUSTOM. The seeded ones
  /// carry their kind so a shop can be asked whether it still has all three.
  kind        String   @default("CUSTOM")
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId, isPublished])
  @@map("store_pages")
}

// Which countries a user may enter. Users holding geo.manage see every
// country of their company without rows here.
model UserCountryAccess {
  id        String   @id @default(uuid())
  userId    String
  countryId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId])
  @@index([countryId])
  @@map("user_country_access")
}

// Optional narrowing inside an accessible country. No rows for a country
// = every store of that country is accessible.
model UserStoreAccess {
  id        String   @id @default(uuid())
  userId    String
  storeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("user_store_access")
}

// ─── ORDER LINES (Stage 3) ───
// One row per product line. Reservation and discount live HERE, never on the
// order: an order with a single unreserved line cannot reach READY_TO_SHIP,
// and a partial return must refund that line's real share of the discount.
model OrderItem {
  id            String   @id @default(uuid())
  companyId     String
  orderId       String
  productId     String
  productName   String // snapshot at creation
  quantity      Int
  freeQuantity  Int      @default(0) // gift units: real stock, zero price
  unitPrice     Decimal  @db.Decimal(14, 3)
  discountShare Decimal  @default(0) @db.Decimal(14, 3) // proportional share of the order discount
  lineTotal     Decimal  @db.Decimal(14, 3) // quantity * unitPrice - discountShare
  reservedQty   Int      @default(0)
  // Stage 9 — partial delivery. What the customer actually took of this
  // line. Null until the parcel is settled at the door; after that
  // deliveredQty + returnedQty equals quantity + freeQuantity.
  deliveredQty  Int?
  returnedQty   Int?
  addedById     String? // who added the line (cross-sell attribution)
  addedStage    String? // INTAKE | CONFIRMATION | CUSTODY
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([companyId, productId])
  @@map("order_items")
}

// ─── ORDER NOTES (Stage 3) ───
// The context layer. Immutable by contract: no edit, no delete, corrections
// are new notes. Never add a typed field for something a note already covers.
model OrderNote {
  id        String   @id @default(uuid())
  companyId String
  orderId   String
  body      String
  authorId  String?
  kind      String   @default("internal") // follow_up | return | settlement | internal
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([companyId, kind])
  @@map("order_notes")
}

// ─── CHANGE REQUESTS (Stage 4) ───
// A confirmed order is read-only for the agent: changing it goes through a
// request. A BLOCKING request stops OUR forward transitions only — courier
// webhook events are always recorded and flag the request as changed during
// review (contract invariant 7).
model OrderChangeRequest {
  id                  String    @id @default(uuid())
  companyId           String
  orderId             String
  requestedById       String
  requestedRole       String
  /// EDIT | CANCEL | POSTPONE — which of the three things is being asked
  /// for. EDIT carries `changes`; POSTPONE carries `postponeUntil`; CANCEL
  /// carries only the reason.
  intent              String    @default("EDIT")
  /// { field: { from, to } } — what the requester wants changed
  changes             Json
  /// The day a POSTPONE request is asking to wait until.
  postponeUntil       DateTime?
  /// A CANCEL request's reason in the structured taxonomy (REJECTION_REASONS),
  /// picked by the agent who spoke to the customer. `reason` stays the
  /// sentence she wrote; this is the one the reports count.
  cancelReason        String?
  reason              String
  status              String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  blocking            Boolean   @default(true)
  /// SLA deadline; expiry escalates, it NEVER auto-approves (silence is not consent)
  slaDueAt            DateTime?
  escalatedAt         DateTime?
  changedDuringReview Boolean   @default(false)
  decidedById         String?
  decidedAt           DateTime?
  decisionNote        String?
  /// When the approved change was carried out on the order, and by whom.
  /// Null on an approved request means the decision is still waiting to be
  /// applied — the state the queue shows under «بانتظار التطبيق». Set once:
  /// an applied request is never applied again.
  appliedAt           DateTime?
  appliedById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([orderId, status])
  @@map("order_change_requests")
}

// ─── ENTRY ISSUES (Stage 4) ───
// Only for orders a moderator entered: a store-sourced order has no
// moderator to return it to. An issue is never counted as a cancellation
// against the agent, and the order keeps its original created_at.
model OrderIssue {
  id           String    @id @default(uuid())
  companyId    String
  orderId      String
  raisedById   String
  reason       String // WRONG_PHONE | WRONG_ADDRESS | WRONG_PRODUCT | MISSING_DATA | DUPLICATE | OTHER
  note         String?
  status       String    @default("OPEN") // OPEN | CORRECTED | VOIDED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([orderId])
  @@map("order_issues")
}

// ─── DELIVERY FEES (Stage 5) ───
// A separate row per courier per country per region, with the fee and the
// late-threshold days used by tracking. The fee on an order is a snapshot;
// changing the table never rewrites a live order.
model DeliveryFee {
  id                 String   @id @default(uuid())
  companyId          String
  countryId          String
  deliveryProviderId String
  regionId           String
  fee                Decimal  @db.Decimal(14, 3)
  /// Days in transit after which tracking marks the shipment late.
  lateThresholdDays  Int      @default(3)
  /// Fee charged by the courier for a returned shipment.
  returnFee          Decimal  @default(0) @db.Decimal(14, 3)
  isActive           Boolean  @default(true)
  /// The courier's OWN id for this region, required on every shipment they
  /// accept. This row already means "this courier, this region", so their
  /// id for it lives here rather than in a second table saying the same.
  /// Null = we do not have it yet, and the adapter falls back to asking.
  courierCityId      Int?     @map("courier_city_id")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  country  Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  provider DeliveryProvider @relation(fields: [deliveryProviderId], references: [id], onDelete: Cascade)
  region   Region           @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([deliveryProviderId, regionId])
  @@index([companyId, countryId])
  @@map("delivery_fees")
}

// ─── RETURN RECEIVING (Stage 5) ───
// Nothing re-enters stock before a physical count and inspection: the
// acknowledgement is a column, not a checkbox in the UI. Missing units are
// computed (shipped - received - damaged), never typed.
model ReturnReceipt {
  id                String   @id @default(uuid())
  companyId         String
  orderId           String   @unique
  expectedQty       Int
  receivedQty       Int
  damagedQty        Int      @default(0)
  missingQty        Int      @default(0)
  courierFeeCharged Boolean  @default(false)
  courierFeeAmount  Decimal  @default(0) @db.Decimal(14, 3)
  /// Set only when the receiver confirms they counted and inspected the goods.
  inspectedById     String
  inspectedAt       DateTime @default(now())
  note              String?
  /// Stock movement created after the acknowledgement, if any.
  stockRestored     Boolean  @default(false)
  createdAt         DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("return_receipts")
}

// ─── WALLETS (Stage 6) ───
// A wallet belongs to a COUNTRY, and its currency is chosen per wallet: a
// country may hold a USD cash box beside its local one.
model Wallet {
  id             String   @id @default(uuid())
  companyId      String
  countryId      String
  /// Which store's money this is. A store is a separate business here: its
  /// own cash, its own bank account, its own daily closing. Null only until
  /// a wallet from before this is placed.
  storeId        String?  @map("store_id")
  name           String
  currencyCode   String
  /// Balance the wallet started with; every change after it is a movement.
  openingBalance Decimal  @default(0) @db.Decimal(14, 3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country           Country             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  store             Store?              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  movements         WalletMovement[]
  closings          DailyClosing[]
  openingCount      WalletOpeningCount?
  receipts          StatementReceipt[]
  commissionPayouts CommissionPayout[]
  payslips          Payslip[]
  expenses          Expense[]

  @@unique([companyId, storeId, name])
  @@index([companyId, countryId, isActive])
  @@index([companyId, storeId])
  @@map("wallets")
}

// Every movement carries wallet, direction, amount, party, category and note.
// NOTHING is ever deleted: a correction is a reversing entry that points at
// the original (reversalOfId) and states its reason.
/// THE SIGNED PHYSICAL COUNT BEHIND AN OPENING BALANCE.
///
/// `Wallet.openingBalance` already existed and is already immutable — the
/// wallet PATCH accepts `name` and `isActive` and nothing else. What was
/// missing is the only thing the cutover actually asks for: WHO COUNTED THE
/// MONEY, AND WHEN.
///
/// The audit log records who CREATED the wallet, and that is the person who
/// typed, not the person who counted a cash box at the switch time. Without
/// this row, a wallet opened at zero and a wallet opened at 4,350 after two
/// people counted a drawer are the same shape of data, and the opening
/// balance is a term in every daily closing that follows it.
///
/// One row per wallet, ever: `walletId` is unique. The count is not a
/// correction instrument — a wallet that has started moving is reconciled by
/// the daily closing, which already compares book against counted and makes
/// somebody explain the gap.
/// ONE-TIME CODES FOR A LOST PHONE.
///
/// Without these, an authenticator on a broken phone is an owner locked out
/// of their own business with nobody able to let them back in — and the
/// pressure that creates is exactly how a second factor gets switched off
/// for everyone. Hashed like a password, because a database copy must not
/// be a set of keys. Spent once and kept, so the audit can say which.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

model WalletOpeningCount {
  id              String   @id @default(uuid())
  companyId       String
  walletId        String   @unique
  countedAmount   Decimal  @db.Decimal(14, 3)
  currencyCode    String
  /// The person who physically counted. Free text on purpose: the warehouse
  /// keeper holding the drawer may have no login, and naming a user id here
  /// would quietly turn "who counted" into "who typed".
  countedByName   String
  /// When the money was counted — the switch time, not when it was entered.
  countedAt       DateTime
  /// What this replaced, kept so the change is legible afterwards.
  previousOpening Decimal  @db.Decimal(14, 3)
  note            String?
  /// The system user who entered it. Distinct from countedByName by design.
  recordedById    String
  createdAt       DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([companyId, countedAt])
  @@map("wallet_opening_counts")
}

model WalletMovement {
  id             String   @id @default(uuid())
  companyId      String
  walletId       String
  direction      String // IN | OUT
  amount         Decimal  @db.Decimal(14, 3)
  currencyCode   String
  /// Who the money came from or went to (courier, employee, supplier...).
  party          String
  category       String // COURIER_SETTLEMENT | COMMISSION | EXPENSE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT | OTHER
  note           String
  referenceType  String? // STATEMENT | TRANSFER | COMMISSION_PERIOD | ORDER
  referenceId    String?
  /// Set on a reversing entry; the original is never edited or deleted.
  reversalOfId   String?  @unique
  reversalReason String?
  createdById    String
  createdAt      DateTime @default(now())

  wallet     Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reversalOf WalletMovement? @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy WalletMovement? @relation("Reversal")

  @@index([companyId, walletId, createdAt])
  @@index([companyId, category])
  @@index([referenceType, referenceId])
  @@map("wallet_movements")
}

// Wallet to wallet, same or different country. The exchange rate is entered
// by the user, stored here, and NEVER recalculated afterwards.
/// NO FOREIGN KEY ON THE TWO WALLETS, AND THAT IS A DECISION — NOT AN OVERSIGHT.
///
/// `fromWalletId` and `toWalletId` are plain strings: alone among the eight
/// relations to `Wallet`, this one is not declared as a relation, so the
/// database would let a transfer name a wallet that no longer exists.
///
/// The CODE holds it instead — the wallet DELETE counts transfers on both
/// sides (`usageOf` in api/finance/wallets/[id]/route.ts) and refuses while
/// any exist, so no wallet with a transfer against it can be removed.
///
/// Adding the constraint means a migration that FAILS if a single orphan row
/// already exists, on live financial data. Asked and answered by the owner
/// (2026-10-02): leave it, documented. `wallet-transfer-is-held-by-code.test.ts`
/// fails if a delete path stops counting them — which is the day this becomes
/// a real hole rather than a declared one.
model WalletTransfer {
  id           String   @id @default(uuid())
  companyId    String
  fromWalletId String
  toWalletId   String
  amountOut    Decimal  @db.Decimal(14, 3)
  amountIn     Decimal  @db.Decimal(14, 3)
  exchangeRate Decimal  @db.Decimal(14, 6)
  /// INTERNAL | BETWEEN_STORES | BETWEEN_COUNTRIES — decided from the two
  /// wallets when it happened, and kept. Deriving it later would let a
  /// wallet moved to another store rewrite what a past transfer meant.
  kind         String   @default("INTERNAL")
  note         String
  createdById  String
  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, kind])
  @@map("wallet_transfers")
}

// Per wallet, per day: book balance, the counted balance, and the gap.
// A non-zero difference needs a written explanation, and the person who
// records movements may not approve the closing.
model DailyClosing {
  id            String    @id @default(uuid())
  companyId     String
  walletId      String
  date          DateTime  @db.Date
  bookBalance   Decimal   @db.Decimal(14, 3)
  actualBalance Decimal   @db.Decimal(14, 3)
  difference    Decimal   @db.Decimal(14, 3)
  explanation   String?
  status        String    @default("OPEN") // OPEN | APPROVED
  recordedById  String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([walletId, date])
  @@index([companyId, status, date])
  @@map("daily_closings")
}

// ─── SETTLEMENT (Stage 6) — three sequential entities ───
// 1. Statement: what the courier SAYS it owes. The file hash makes a
//    duplicate import impossible.
model CourierStatement {
  id                 String    @id @default(uuid())
  companyId          String
  storeId            String
  deliveryProviderId String
  reference          String
  periodFrom         DateTime?
  periodTo           DateTime?
  /// Total the courier claims, read from the file itself.
  totalAmount        Decimal   @db.Decimal(14, 3)
  currencyCode       String
  fileName           String
  /// SHA-256 of the uploaded file: the same statement can never be imported twice.
  fileHash           String
  status             String    @default("IMPORTED") // IMPORTED | RECEIPTED | MATCHED | APPROVED
  /// Required when the receipts do not add up to the statement total.
  gapExplanation     String?
  uploadedById       String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines    StatementLine[]
  receipts StatementReceipt[]
  matches  SettlementMatch[]

  @@unique([companyId, fileHash])
  @@index([companyId, status, createdAt])
  @@map("courier_statements")
}

/// One row of the courier file, as it was read.
model StatementLine {
  id          String   @id @default(uuid())
  statementId String
  merchantRef String?
  barcode     String?
  // The NET: what the courier hands over after keeping their fee. This is
  // the figure a receipt is measured against.
  amount      Decimal  @db.Decimal(14, 3)
  // What they say they collected from the customer, and the fee they kept.
  // Both are stated so a difference in the net can be traced to its cause:
  // a collection short, or a fee higher than agreed.
  collected   Decimal? @db.Decimal(14, 3)
  fee         Decimal? @db.Decimal(14, 3)
  status      String? // the courier's own status word
  rawRow      String?
  createdAt   DateTime @default(now())

  statement CourierStatement  @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matches   SettlementMatch[]

  @@index([statementId])
  @@index([merchantRef])
  @@map("statement_lines")
}

// 2. Receipt: what ACTUALLY arrived. Many lines per statement, each with its
//    own wallet, currency and amount.
model StatementReceipt {
  id           String   @id @default(uuid())
  companyId    String
  statementId  String
  walletId     String
  amount       Decimal  @db.Decimal(14, 3)
  currencyCode String
  /// Stored when the wallet currency differs from the statement currency.
  exchangeRate Decimal? @db.Decimal(14, 6)
  receivedAt   DateTime @default(now())
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  /// THE PAPER BEHIND THE COLLECTION — «حط رفع ملف صورة او ملف عشان اتحقق
  /// من التحصيل». A photo of the handover slip or the bank's transfer PDF.
  ///
  /// All five are nullable and move together: a receipt with no paper is
  /// still a real receipt — a cash handover in a doorway has none — and
  /// making the file compulsory would stand between a person and recording
  /// money that has already arrived. The database holds the all-or-nothing
  /// part, because a half-written proof (a key with no hash) is worse than
  /// no proof: it looks present and cannot be checked.
  ///
  /// Written only by `POST .../receipts`, read only by the proof route, and
  /// the rules that decide what may be stored live in
  /// `src/lib/settlement-proof.ts`.
  ///
  /// The storage key. Built from the RECEIPT id, never from the uploaded
  /// filename, so a name that came from outside never reaches a path.
  proofKey  String?
  /// What the owner called it, or the file's own name if they called it
  /// nothing. This is what a download is named — never what it is stored as.
  proofName String?
  /// Sniffed from the first bytes, never taken from the extension or from
  /// what the browser claimed. One of four: jpeg, png, webp, pdf.
  proofMime String?
  proofSize Int?
  /// SHA-256 of the bytes as stored, the same way `CourierStatement.fileHash`
  /// remembers the statement file: a proof replaced on disk — by a mistake,
  /// a restore, or a hand — stops matching the row that points at it.
  proofHash String?

  statement CourierStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  wallet    Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([companyId, statementId])
  @@map("statement_receipts")
}

// 3. Matching: runs on demand AFTER the receipt. Key: merchant reference,
//    then courier barcode. NEVER the phone.
model SettlementMatch {
  id              String    @id @default(uuid())
  companyId       String
  statementId     String
  statementLineId String?
  orderId         String?
  result          String // MATCHED | MISMATCHED | MISSING_IN_STATEMENT | MISSING_IN_SYSTEM
  matchedBy       String? // MERCHANT_REF | BARCODE
  expectedAmount  Decimal?  @db.Decimal(14, 3)
  statementAmount Decimal?  @db.Decimal(14, 3)
  difference      Decimal?  @db.Decimal(14, 3)
  // The delivery fee is checked in its own right. With the price INCLUDING
  // delivery, a fee higher than agreed quietly eats the revenue: the net
  // still "arrives", just smaller. Stating both sides names the cause.
  expectedFee     Decimal?  @db.Decimal(14, 3)
  statementFee    Decimal?  @db.Decimal(14, 3)
  feeDifference   Decimal?  @db.Decimal(14, 3)
  note            String?
  /// How the difference was settled: ACCEPTED_COURIER | OURS_STANDS.
  /// Null while it is still an open difference nobody has answered.
  resolution      String?
  resolutionNote  String?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  statement     CourierStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  statementLine StatementLine?   @relation(fields: [statementLineId], references: [id], onDelete: SetNull)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// The «فرق تحصيل» charged to an employee because of this line; at most one is live (penalties_one_live_per_match).
  penalties     Penalty[]

  @@index([companyId, statementId, result])
  @@index([companyId, resolution])
  @@index([orderId])
  @@map("settlement_matches")
}

// ─── COMMISSION (Stage 6) ───
// Rules are DATA with an effective_from date: changing a rule today never
// recalculates a closed period.
model CommissionRule {
  id              String    @id @default(uuid())
  companyId       String
  /// Which store's agreement this is. The stores are separate businesses:
  /// what one pays its agents for a sale is not the other's to inherit.
  storeId         String?   @map("store_id")
  name            String
  /// Who it applies to: a role name, or one specific user.
  appliesToRole   String?
  appliesToUserId String?
  basis           String // ORDER_DELIVERED (accrual point per contract)
  type            String // PERCENT | FIXED | PER_ORDER
  value           Decimal   @db.Decimal(12, 4)
  /// WHAT is being counted — see COMMISSION_METRICS in src/lib/commission-rules.ts.
  /// ORDER_DELIVERED keeps the old behaviour: one accrual per delivered order.
  metric          String    @default("ORDER_DELIVERED")
  /// Over WHAT SPAN it is counted: PER_ORDER (as it happens) or DAILY /
  /// WEEKLY / MONTHLY, which can only be known once the span has closed.
  period          String    @default("PER_ORDER")
  /// Bands: [{ from, to, value, label }]. Null = the single `value` above.
  tiers           Json?
  /// A target on ONE product rather than on everything sold.
  productId       String?   @map("product_id")
  /// Below this many counted orders the rule pays nothing — a delivery rate
  /// out of three orders is noise, not performance.
  minOrders       Int?      @map("min_orders")
  /// Minimum sample before delivery-rate tiers may be applied.
  /// RETIRED 2026-10-02 — nothing writes, reads or selects it.
  ///
  /// It carried the contract's «minimum sample of 30 orders» and no code ever
  /// looked at it, while `minOrders` — the field `earnedBy` actually checks
  /// the sample against — was optional and null on every rule. Two columns
  /// for one idea, and the live one was the one without the number. The floor
  /// is `minOrders` now, defaulted to 30 for DELIVERY_RATE at the save door.
  ///
  /// Kept in the schema because financial history is not deleted, exactly as
  /// `Order.moderatorCommission` is. Guarded in `the-commission-invariants`.
  minSampleOrders Int       @default(30)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  isActive        Boolean   @default(true)
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries CommissionEntry[]

  @@index([companyId, storeId])
  @@index([companyId, isActive, effectiveFrom])
  @@index([companyId, metric, isActive], map: "commission_rules_company_metric_idx")
  @@map("commission_rules")
}

// Accrued on DELIVERED, payable only after settlement approval. A returned
// order generates zero commission for every party, and a correction is a
// reversing entry — the monthly period is locked once approved.
model CommissionEntry {
  id             String    @id @default(uuid())
  companyId      String
  /// The order that earned it — null for a PERIOD entry, which no single
  /// order produced ("150 confirmed in a day"). What such an entry was
  /// earned on is written below: its span, its count and its tier.
  orderId        String?
  userId         String
  role           String
  ruleId         String?
  amount         Decimal   @db.Decimal(14, 3)
  currencyCode   String
  /// ACCRUED (delivered) -> PAYABLE (settlement approved) -> PAID, or REVERSED.
  status         String    @default("ACCRUED")
  /// YYYY-MM of the delivery; the period is locked when approved.
  periodMonth    String
  /// A PERIOD entry: the span it covers, how many orders were counted in it,
  /// and which band that fell into — so the figure can be traced back.
  periodStart    DateTime? @map("period_start")
  periodEnd      DateTime? @map("period_end")
  counted        Int?
  tierLabel      String?   @map("tier_label")
  /// The payment that settled it. Null until it is paid.
  payoutId       String?   @map("payout_id")
  reversalOfId   String?   @unique
  reversalReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order      Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rule       CommissionRule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  payout     CommissionPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reversalOf CommissionEntry?  @relation("CommissionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy CommissionEntry?  @relation("CommissionReversal")

  @@unique([orderId, userId, status])
  /// ALSO HELD BY THE DATABASE, AND NOT EXPRESSIBLE HERE:
  /// `commission_entries_period_key` — UNIQUE (userId, ruleId, period_start)
  /// WHERE period_start IS NOT NULL AND status <> 'REVERSED'. Prisma cannot
  /// write a PARTIAL unique index, so it lives in the migration
  /// `20260925180000_commission_tiers`.
  ///
  /// It is what stops `accrue-period-commission` — which runs every hour
  /// against the same closed span — paying a person twice. The @@unique above
  /// does NOT cover it: a period entry has `orderId` NULL, and Postgres counts
  /// every NULL in a unique index as distinct.
  ///
  /// Said here because an auditor reading this model saw only the line above,
  /// concluded the period accrual was unprotected, and came within one
  /// migration of adding a second index doing the same job.
  @@index([companyId, periodMonth, status])
  @@index([userId, periodMonth])
  @@index([payoutId], map: "commission_entries_payout_idx")
  @@map("commission_entries")
}

/// Monthly commission statement per user: locked after approval, corrections
/// are reversing entries in the next period.
/// ONE PAYMENT OF COMMISSION, AND WHERE THE MONEY CAME FROM.
///
/// An entry used to reach PAYABLE and stop: nothing turned it into money.
/// A payout closes the loop — it names the wallet the cash actually left,
/// what left it in THAT wallet's currency, and the rate the owner used.
///
/// The rate is entered, stored, and never recalculated — the same rule as a
/// wallet transfer. A month already paid must read the same next year.
/**
 * A RULE THAT PROPOSES A DEDUCTION — it never applies one.
 * Grace and a cap are not softness. A rule with no grace charges somebody
 * every day traffic exists, and a deduction that happens every day stops
 * being a signal about anything. A rule with no cap can eat a salary over
 * one illness.
 */
model PenaltyRule {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  /// Null = every store of the company.
  storeId       String?   @map("store_id")
  /// Null = every role.
  role          String?
  /// See PENALTY_KINDS in src/lib/penalties.ts.
  kind          String
  /// What ONE unit costs: a minute late, an absent day, an untouched order.
  perUnit       Decimal   @map("per_unit") @db.Decimal(12, 4)
  /// Units forgiven before anything is charged.
  grace         Int       @default(0)
  /// The most this rule may take from one person in one period.
  periodCap     Decimal?  @map("period_cap") @db.Decimal(14, 3)
  currencyCode  String    @map("currency_code")
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String    @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  penalties Penalty[]

  @@index([companyId, kind])
  @@index([companyId, isActive])
  @@map("penalty_rules")
}

/**
 * ONE PROPOSED OR APPLIED DEDUCTION.
 * Nothing here becomes money on its own. The system can measure that
 * somebody arrived at 09:40; it cannot know there was a funeral, a closed
 * road, or a shift swapped by phone. And an arrival taken from the first
 * order somebody touched is an UPPER BOUND — taking money on an upper
 * bound is not a policy, it is an error with a receipt.
 * So: PROPOSED by the system, APPLIED or WAIVED by a person, and REVERSED
 * by a linked opposite row rather than by a delete — the same rule every
 * financial record in this system lives by.
 */
/// ALSO HELD BY THE DATABASE: `penalties_one_live_per_day` —
/// UNIQUE (company_id, user_id, kind, occurred_on) WHERE status IN
/// ('PROPOSED','APPLIED') AND settlement_match_id IS NULL, created in the
/// migration `20260925230000_penalties` and narrowed by
/// `20261029120000_shortfall_penalty`.
/// It is what makes `propose-penalties` safe to run twice, and partial so a
/// REVERSED or WAIVED charge leaves the day free for a corrected one.
/// `recordProposals` swallows the violation on purpose — see penalty-service.
/// The clause on `settlement_match_id` is why a collection shortfall is not
/// held by it: two short orders delivered on one day are two differences, and
/// the day rule would have refused the second. A shortfall is held by its own
/// index, `penalties_one_live_per_match`: UNIQUE (settlement_match_id) WHERE
/// status IN ('PROPOSED','APPLIED') AND settlement_match_id IS NOT NULL — one
/// live charge per difference, so a second approval press cannot charge twice.
model Penalty {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  storeId      String    @map("store_id")
  userId       String    @map("user_id")
  ruleId       String?   @map("rule_id")
  kind         String
  /// The day it happened, so one day can never be charged twice.
  occurredOn   DateTime  @map("occurred_on") @db.Date
  /// The raw measurement kept beside the money: 40 minutes, 1 day, 3 orders.
  /// Without it nobody can check the arithmetic a month later.
  units        Int
  /// What was charged after grace and cap.
  chargedUnits Int       @map("charged_units")
  amount       Decimal   @db.Decimal(14, 3)
  currencyCode String    @map("currency_code")
  /// PROPOSED | APPLIED | WAIVED | REVERSED
  status       String    @default("PROPOSED")
  note         String?
  proposedAt   DateTime  @default(now()) @map("proposed_at")
  decidedById  String?   @map("decided_by_id")
  decidedAt    DateTime? @map("decided_at")
  /// Why it was waived or reversed. The service requires it: a deduction
  /// cancelled with no reason is indistinguishable from a favour.
  decisionNote String?   @map("decision_note")
  /// Reversing entries only, linked to the original — never a delete.
  reversesId   String?   @unique @map("reverses_id")
  /// The payslip that settled it. Null while it is still owed.
  payslipId    String?   @map("payslip_id")
  /// The line of a courier statement this charge is about. Set only on a
  /// «فرق تحصيل» (kind SHORTFALL), written by the approval of the statement;
  /// null on every charge a rule measured (lateness, absence, …).
  settlementMatchId String? @map("settlement_match_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  rule            PenaltyRule?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  payslip         Payslip?         @relation(fields: [payslipId], references: [id], onDelete: Restrict)
  reverses        Penalty?         @relation("PenaltyReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy      Penalty?         @relation("PenaltyReversal")
  settlementMatch SettlementMatch? @relation(fields: [settlementMatchId], references: [id], onDelete: Restrict)

  @@index([companyId, userId, status])
  @@index([companyId, status, occurredOn])
  @@index([payslipId])
  @@index([settlementMatchId])
  @@map("penalties")
}

/**
 * ONE MONTH'S PAY, AND WHAT WAS TAKEN OUT OF IT.
 * The salary is a SNAPSHOT. Reading it from the employee later would
 * rewrite last March every time somebody gets a rise, and a payslip that
 * changes is not a record of anything.
 * `carriedOver` is the guard that matters: deductions larger than the
 * salary do not produce a negative payment. What did not fit stays owed
 * and is offered against the next payslip — a person is never handed a bill
 * instead of wages.
 */
model Payslip {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  storeId      String   @map("store_id")
  userId       String   @map("user_id")
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  /// The salary as it stood when this was paid.
  salaryAmount Decimal  @map("salary_amount") @db.Decimal(14, 3)
  currencyCode String   @map("currency_code")
  penaltyTotal Decimal  @default(0) @map("penalty_total") @db.Decimal(14, 3)
  netAmount    Decimal  @map("net_amount") @db.Decimal(14, 3)
  /// Deductions that exceeded the salary and were NOT settled here.
  carriedOver  Decimal  @default(0) @map("carried_over") @db.Decimal(14, 3)
  walletId     String   @map("wallet_id")
  /// What actually left, in the WALLET's currency, at the rate the owner
  /// wrote at payment. Stored and never recalculated.
  paidAmount   Decimal  @map("paid_amount") @db.Decimal(14, 3)
  paidCurrency String   @map("paid_currency")
  exchangeRate Decimal  @map("exchange_rate") @db.Decimal(14, 6)
  /// Deductions in ANOTHER currency than the salary's, converted at payment at a rate the payer typed.
  /// `settledAmount` is what they came to in THEIR OWN currency (`settledCurrency`); `settledRate` is the
  /// salary currency per one unit of it. All three are null when nothing was converted. Stored and never
  /// recalculated, like `exchangeRate`: a month already paid reads the same next year.
  settledAmount   Decimal? @map("settled_amount") @db.Decimal(14, 3)
  settledCurrency String?  @map("settled_currency")
  settledRate     Decimal? @map("settled_rate") @db.Decimal(14, 6)
  note         String?
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  penalties Penalty[]

  @@unique([companyId, userId, periodStart], map: "payslips_one_per_period")
  @@index([companyId, createdAt])
  @@index([walletId])
  @@map("payslips")
}

model CommissionPayout {
  id           String   @id @default(uuid())
  companyId    String
  userId       String
  walletId     String
  /// What the person earned, in THEIR currency.
  amount       Decimal  @db.Decimal(14, 3)
  currencyCode String
  /// What actually left the wallet, in the WALLET's currency.
  paidAmount   Decimal  @db.Decimal(14, 3)
  paidCurrency String
  exchangeRate Decimal  @db.Decimal(14, 6)
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  wallet  Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries CommissionEntry[]

  @@index([companyId, userId, createdAt], map: "commission_payouts_company_user_idx")
  @@index([walletId], map: "commission_payouts_wallet_idx")
  @@map("commission_payouts")
}

model CommissionPeriod {
  id           String    @id @default(uuid())
  companyId    String
  userId       String
  periodMonth  String
  totalAmount  Decimal   @db.Decimal(14, 3)
  currencyCode String
  status       String    @default("OPEN") // OPEN | APPROVED | PAID
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([companyId, userId, periodMonth])
  @@index([companyId, status])
  @@map("commission_periods")
}

// ─────────────────────────────────────────────────────────────────────────
// Stage 7 — the scheduler.
//
// Half the system is inert without it: claims that should auto-release wait
// for someone to open a screen, postponed orders resurface only if a human
// remembers, commission accrues only when asked. A run log per job is what
// makes a missed window visible instead of silent.
// ─────────────────────────────────────────────────────────────────────────

model JobRun {
  id         String    @id @default(uuid())
  jobName    String
  status     String    @default("RUNNING") // RUNNING | SUCCEEDED | FAILED
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /**
   * How many things the run actually acted on — 0 is a valid quiet run.
   */
  processed  Int       @default(0)
  /**
   * A short human summary, and the error when it failed.
   */
  detail     String?
  error      String?
  /**
   * Which company/country the run covered, when a job is scoped.
   */
  companyId  String?
  countryId  String?

  /// ── ONE PARTIAL UNIQUE INDEX THE SCHEMA CANNOT EXPRESS ──
  ///
  /// `job_runs_one_running` — UNIQUE (jobName) WHERE status = 'RUNNING'
  ///
  /// The claim used to be read-then-create in `src/lib/jobs/runner.ts`:
  /// two workers a millisecond apart both saw no RUNNING row and both
  /// created one, so the job ran twice. Harmless while one container ran
  /// the worker; not harmless the moment two do, which the rolling update
  /// introduced — and `accrue-commission`, `accrue-period-commission`,
  /// `propose-penalties`, `deliver-conversions` and `deliver-app-events`
  /// are jobs where twice means money or a double-reported conversion.
  ///
  /// `@@unique([jobName])` cannot say it: a job has many finished runs and
  /// only ever one live one. In
  /// `20261015210000_one_worker_one_job/migration.sql`.

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("job_runs")
}

// Blocking a customer.
//
// Keyed on the PHONE, not on a customer row: the phone is the identity, and
// somebody refused delivery three times will happily order again under a new
// name. Company-wide and never country-scoped — the same person is the same
// person in every store.
//
// A block is never deleted, only RELEASED, so the history of who blocked
// whom and why survives the decision to let them back.
model CustomerBlock {
  id            String    @id @default(uuid())
  companyId     String
  /**
   * Normalized digits, the same form customer.phone is stored in.
   */
  phone         String
  /**
   * Kept for the screen; the phone is what is matched on.
   */
  name          String?
  reason        String
  blockedById   String
  createdAt     DateTime  @default(now())
  releasedAt    DateTime?
  releasedById  String?
  releaseReason String?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blockedBy  User    @relation("CustomerBlockedBy", fields: [blockedById], references: [id], onDelete: Restrict)
  releasedBy User?   @relation("CustomerBlockReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  // One ACTIVE block per phone is enforced in the service, not here: a
  // released block must be able to sit beside a new one for the same phone.
  @@index([companyId, phone, releasedAt])
  @@map("customer_blocks")
}

// ─── THE APP PLATFORM (additive) ───
// Integrations used to exist without a common idea of "installed": a courier
// adapter, tracking pixels, a WhatsApp connection, Telegram sources — each
// with its own screen and no answer to "what is connected, and who turned it
// on". Two kinds share one shelf: BUILT-IN apps declared in code (their
// configuration already has a screen, so the store records the install and
// links to it), and EXTERNAL apps a developer registers.

/// An app registered by an outside developer. Built-ins are NOT here: they
/// live in src/lib/apps/registry.ts, and a catalogue row for something that
/// lives in code would be a second source of truth about what the code does.
model App {
  id            String   @id @default(uuid())
  companyId     String
  code          String
  name          String
  description   String?
  developerName String?
  iconUrl       String?
  webhookUrl    String?
  /// Event names it asked to hear about, as a JSON array.
  events        String   @default("[]")
  /// HMAC signing secret, encrypted at rest. Shown once at registration and
  /// never again by any endpoint.
  secret        String?
  status        String   @default("ACTIVE") // ACTIVE | DISABLED
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  installs AppInstall[]

  @@unique([companyId, code])
  @@map("apps")
}

/// One company's installation of an app, built-in or external.
model AppInstall {
  id            String   @id @default(uuid())
  companyId     String
  /// The built-in's code or the external app's code — one column, so the
  /// installed list is one query and one shape.
  appCode       String
  appId         String?
  enabled       Boolean  @default(true)
  /// Per-install settings, encrypted: an app's configuration is as sensitive
  /// as the account it configures.
  config        String?
  installedById String?
  installedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  app        App?          @relation(fields: [appId], references: [id], onDelete: Cascade)
  deliveries AppDelivery[]

  @@unique([companyId, appCode])
  @@index([companyId, enabled])
  @@map("app_installs")
}

/// Every attempt to tell an app something. A webhook that fails silently is
/// an integration that stops silently, and the developer cannot know.
model AppDelivery {
  id            String    @id @default(uuid())
  companyId     String
  installId     String
  event         String
  payload       String    @db.Text
  url           String
  status        String    @default("PENDING") // PENDING | OK | FAILED
  attempts      Int       @default(0)
  responseCode  Int?
  error         String?
  nextAttemptAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  install AppInstall @relation(fields: [installId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([companyId, createdAt])
  @@map("app_deliveries")
}

/// A KEY ANOTHER SYSTEM CALLS IN WITH — the door `/api/v1` opens for.
///
/// Every other `/api` route in this product needs a browser session, which is why the
/// replies system (System 7) has worked by copy-and-paste: there was no way
/// for a program to be let in. This is that way, and it is deliberately
/// narrower than a session.
///
/// WHAT IS STORED IS NOT THE TOKEN. `tokenHash` is the SHA-256 of it; the
/// token itself is shown once, at creation, and no endpoint can ever return
/// it again. A stolen database dump is therefore not a stolen door — the
/// same discipline `App.secret` follows, except that this one cannot even be
/// decrypted, because nothing here ever needs to send it anywhere.
///
/// `prefix` is the first few characters, kept in the clear so a screen can
/// tell two tokens apart without being told either of them.
///
/// THE COMPANY COMES FROM THE TOKEN AND NEVER FROM THE REQUEST. That is the
/// whole of the tenant rule at this door: a caller cannot name a company,
/// only prove which one it holds a key to.
model SystemToken {
  id              String    @id @default(uuid())
  companyId       String
  /// What a person calls it on the screen — «نظام الردود · الإنتاج».
  name            String
  /// Which outside system it was made for. `replies` is System 7.
  system          String
  /// SHA-256 of the token, hex. Unique across the product: a collision
  /// would be one company's key opening another's door.
  tokenHash       String    @unique
  /// The first characters of the token, for recognising it on a screen.
  prefix          String
  /// The named scopes, as a JSON array — the same shape `App.events` uses.
  /// A Postgres `String[]` would read better and would be the one column in
  /// this file that is an array; the JSON string keeps the table matching
  /// the table beside it.
  scopes          String    @default("[]")
  rateLimitPerMin Int       @default(60)
  /// 90 days by default, set by the screen that creates it. Null means it
  /// never expires, which the screen does not offer.
  expiresAt       DateTime?
  /// Stopped immediately, and never deleted: who opened a door and who shut
  /// it survives the shutting, like a released block or a reversed entry.
  revokedAt       DateTime?
  /// The last time this key was accepted. Written at most once a minute —
  /// a read-only call must not cost a write on every request.
  lastUsedAt      DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId, revokedAt])
  @@map("system_tokens")
}

/// THE SAME REQUEST, SENT TWICE, IS ONE ORDER.
///
/// Another system retries. A webhook times out, a worker restarts, a person
/// presses «ترحيل» again — and a door that creates an order per call turns
/// one customer into two orders, two reservations and two waybills. So every
/// write at `/api/v1` carries an `Idempotency-Key`, and the FIRST answer is
/// kept here and replayed.
///
/// `requestHash` is what makes the key honest. The same key with a DIFFERENT
/// body is not a retry, it is a mistake — two different orders claiming one
/// key — and it is refused with 409 rather than silently answered with the
/// first one's order number.
model IdempotencyRecord {
  id          String   @id @default(uuid())
  companyId   String
  /// The caller's key. Scoped to the company: two companies' keys live in
  /// separate spaces, so one cannot collide with — or read — the other's.
  key         String
  /// SHA-256 of the method, the path and the body.
  requestHash String
  /// The HTTP status the first attempt answered with, replayed as it was.
  status      Int
  /// The body the first attempt answered with, replayed verbatim.
  response    String   @db.Text
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId, createdAt])
  @@map("idempotency_records")
}

/// THE FINGERPRINT — append-only marks of arriving and leaving.
///
/// AUTO is the login: signing in IS the fingerprint, and an account opens on
/// one device at a time, so it cannot be pressed from somebody else's phone.
/// MANUAL is the "استلمت" / "سلّمت" buttons, for hours that leave no trace in
/// the order records — a meeting, a training, a queue that stayed empty.
///
/// Nothing derived is stored. Hours worked, lateness and late-day counts are
/// computed from these moments and the country's work hours, so changing the
/// shift never leaves a stale number behind.
model AttendanceMark {
  id        String   @id @default(uuid())
  /// Null for a platform-level account, which belongs to no company.
  companyId String?
  userId    String
  /// LOGIN | CHECK_IN | CHECK_OUT
  kind      String
  /// AUTO (the system saw it) | MANUAL (somebody pressed it)
  source    String   @default("AUTO")
  at        DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Restrict, not cascade: deleting a user must not quietly erase the
  /// record of the days they worked.
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([companyId, at])
  @@index([userId, at])
  @@map("attendance_marks")
}

/// A typeface the seller uploaded, served to their own landing pages.
///
/// Per store, like everything else a store owns: a font bought for one
/// brand is not a font the next brand may set its headlines in, and a
/// licence is usually granted to a domain.
///
/// `notice` is the licence text read out of the file at upload. It is kept
/// so the panel can show the seller what the designer wrote — most Arabic
/// type forbids being served from a website, and a seller who uploads one
/// is usually not defying that, they have simply never seen it, because it
/// is buried in a binary. Storing it means they are told once, plainly,
/// rather than never.
model StoreFont {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  storeId    String    @map("store_id")
  /// The slug used in CSS and in the picker. One per family per store.
  key        String
  /// What the seller calls it, in their own words.
  label      String
  /// The family name read from the file — what the browser matches on.
  family     String
  weight     Int       @default(400)
  italic     Boolean   @default(false)
  storageKey String    @map("storage_key")
  sizeBytes  Int       @map("size_bytes")
  format     String // woff2 | woff | otf | ttf
  /// Copyright and licence as the designer embedded them. May be empty.
  notice     String?   @db.Text
  /// True when the designer's own words suggest serving it is not allowed.
  /// A hint shown to the seller, never a block.
  restricted Boolean   @default(false)
  /// The seller's statement that they hold the right to serve this file.
  /// Recorded with who and when, because that is the whole point of asking.
  attestedBy String?   @map("attested_by")
  attestedAt DateTime? @map("attested_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([companyId, storeId, key, weight, italic])
  @@index([companyId, storeId])
  @@map("store_fonts")
}

/// A paid campaign: what was spent, and what came back.
///
/// The platforms will not tell us what was spent without an ad account's
/// API keys, and a seller reading their own ads manager can type a number
/// in ten seconds. So spend is entered, and everything else is MEASURED —
/// the orders, the confirmations, the deliveries and the money collected
/// all come from this system's own records through the same attribution
/// engine the moderator and channel reports use. One definition of
/// "revenue" across every screen, or two screens eventually disagree about
/// one week.
///
/// Per store, like everything a store owns. A campaign runs for one shop.
model Campaign {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  storeId       String    @map("store_id")
  name          String
  /// META | TIKTOK | SNAPCHAT | GOOGLE | OTHER — for grouping, not for an API.
  platform      String    @default("META")
  /// The short code that appears in the ad's link as ?c=CODE.
  ///
  /// Unique per store and never reused: an order carries the campaign it
  /// was resolved to, and a recycled code would move last month's orders
  /// onto this month's spend.
  code          String
  /// Which page the ad points at. Optional — a campaign may send traffic
  /// to a storefront, or to a page that was later deleted.
  landingPageId String?   @map("landing_page_id")
  /// WHICH PRODUCT THIS CAMPAIGN ADVERTISES — «اقدر احدد كل حملة لاي منتج».
  ///
  /// AND IT IS NOT A SECOND COPY OF `landingPageId`'s ANSWER. Measured
  /// before this column existed: 44 of 44 landing pages name a product, so
  /// for any campaign pointing at a page the product is already KNOWN, and
  /// deriving it is the only honest thing to do. A column that re-states a
  /// derivable fact is a figure that can disagree with itself.
  ///
  /// THIS EXISTS FOR WHAT DERIVATION CANNOT REACH: a campaign with NO
  /// landing page — an ad pointing at a storefront product page, or at a
  /// WhatsApp thread. `landingPageId` is nullable, so such a campaign is a
  /// real one, and before this it could never say what it was selling.
  ///
  /// `campaignProductId()` in `campaigns.ts` is the ONE place that answers
  /// the question. A campaign whose page names product A while this column
  /// names B is REFUSED at the door rather than resolved: a contradiction
  /// that quietly picks a winner is a figure nobody can trust.
  productId     String?   @map("product_id")
  status        String    @default("ACTIVE") // ACTIVE | PAUSED | ENDED
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  /// What was spent. Typed by the seller, or pulled from the ad account
  /// when one is linked — `spendSource` says which, so nobody wonders why
  /// a number they typed changed overnight.
  /// Three decimals, like every other money column — see the note on
  /// `Order.collectedAmount`. This one was `Decimal(14, 2)` and a sweep
  /// over `Decimal(12, 2)` passed straight over it: fourteen digits and
  /// two decimals is still two decimals, and the dinar has three.
  spend         Decimal   @default(0) @db.Decimal(14, 3)
  /// MANUAL | SYNCED
  spendSource   String    @default("MANUAL") @map("spend_source")
  /// The ad account this campaign's spend comes from, when it is synced.
  adAccountId   String?   @map("ad_account_id")
  /// The campaign's id ON THE PLATFORM. Matching by name would break the
  /// first time somebody renamed a campaign in Ads Manager, which is a
  /// thing people do constantly.
  externalId    String?   @map("external_id")
  lastSyncAt    DateTime? @map("last_sync_at")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdById   String?   @map("created_by_id")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  landingPage LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  /// `SetNull`, like the page above it: deleting a product must not delete
  /// the campaign, because the spend it recorded was real money that left.
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  adAccount   AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  orders      Order[]

  /// The place the seller dragged it to on the campaigns screen — «الدراج اند دروب وترتيب الحملات عندي». Shared
  /// by everyone who sees the screen. 0 for every campaign until somebody orders them; ties fall back to status
  /// then newest first, as the list always read.
  sortOrder   Int       @default(0) @map("sort_order")

  @@unique([companyId, storeId, code])
  @@index([companyId, storeId, sortOrder])
  @@index([companyId, storeId, status])
  @@map("campaigns")
}

/// A connected advertising account — the place the spend numbers come from.
///
/// Per store, like everything a store owns. An ad account belongs to one
/// brand, its token is scoped to that account, and a spend figure pulled
/// into the wrong shop is worse than no figure at all.
///
/// The TOKEN is write-only. It is encrypted before it is stored, never
/// returned by any endpoint, and never written to an audit entry — the same
/// rule the courier logins and the AI key follow. Only a hint comes back,
/// so a seller can tell which token is in there.
model AdAccount {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  storeId        String    @map("store_id")
  /// META for now. TIKTOK and SNAPCHAT speak different APIs, not different
  /// rows — this names which adapter reads it.
  platform       String    @default("META")
  /// The account as the platform names it: act_1234567890 on Meta.
  accountId      String    @map("account_id")
  /// What the platform calls it, read back at connection time. A seller with
  /// four ad accounts cannot tell act_ numbers apart.
  accountName    String?   @map("account_name")
  /// The access token, encrypted. Never leaves the server.
  ///
  /// NULL FOR A MANUAL ACCOUNT, AND ONLY THEN: «ادخال يدوي بالكامل». A seller
  /// who does not want to connect anything still has an ad account — a name
  /// to group campaigns under and a platform to count them by — and a
  /// column that demanded a token would have forced the lie «connected».
  /// The pairing is held by the database, not by a hope: see the CHECK on
  /// `status` below, which exists only in the migration (Prisma has no
  /// syntax for it).
  tokenEncrypted String?   @map("token_encrypted") @db.Text
  /// Last four characters, so the seller knows which token this is.
  tokenHint      String?   @map("token_hint")
  /// CONNECTED | ERROR | MANUAL — a token that stopped working says so here
  /// rather than failing silently every night; MANUAL has no token, no
  /// platform call and no sync, by CHECK ("status" = 'MANUAL') = (token IS NULL).
  status         String    @default("CONNECTED")
  /// Why it stopped, in the platform's own words, for the screen to show.
  lastError      String?   @map("last_error") @db.Text
  lastSyncAt     DateTime? @map("last_sync_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    String?   @map("created_by_id")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@unique([companyId, storeId, platform, accountId])
  @@index([companyId, storeId])
  @@map("ad_accounts")
}

/// A landing page's views, counted per day, per device and per campaign.
///
/// The page's own `viewsCount` is one lifetime number: it cannot answer
/// "last week", "from phones" or "from this advert", and the performance
/// screen asks all three for one date window. So each public render adds
/// one here as well, into its day's row. Counting starts the day this ships
/// — there is no history to rebuild.
///
/// No personal data: a device CLASS and a campaign id, never an IP or a
/// user agent. Link-preview crawlers are not counted.
model LandingPageView {
  id            String   @id @default(uuid())
  companyId     String
  storeId       String?
  landingPageId String
  day           DateTime @db.Date
  /// mobile | tablet | desktop
  device        String
  /// '' when the visit carried no campaign code. Empty rather than null so
  /// the day's row is one row, not one per NULL.
  campaignId    String   @default("")
  count         Int      @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, day, device, campaignId])
  @@index([companyId, storeId, day])
  @@map("landing_page_views")
}

/// THE SAME VISITS, COUNTED BY THE BROWSER.
///
/// The exact shape of `LandingPageView`, written by `/api/public/lp-view` when the page has opened in a visitor's
/// browser. Counted beside the server's rows for a week, so the owner can compare the two before the page is cached —
/// a cached page is not built per visit, so the server can no longer count it. Read by nothing that computes money.
model LandingPageBrowserView {
  id            String   @id @default(uuid())
  companyId     String
  storeId       String?
  landingPageId String
  day           DateTime @db.Date
  /// mobile | tablet | desktop
  device        String
  campaignId    String   @default("")
  count         Int      @default(0)

  landingPage LandingPage @relation(fields: [landingPageId], references: [id], onDelete: Cascade)

  @@unique([landingPageId, day, device, campaignId])
  @@index([companyId, storeId, day])
  @@map("landing_page_browser_views")
}

/// A REGISTERED AUTHENTICATOR — a fingerprint, a face, a security key.
///
/// Nothing secret is stored. `publicKey` is the SPKI the browser itself
/// hands over at registration: a copy of this table lets somebody VERIFY a
/// signature and never lets them produce one.
model Passkey {
  id           String    @id @default(uuid())
  userId       String
  /// The authenticator's credential id, base64url as the browser sends it.
  credentialId String    @unique
  /// SPKI DER, base64. Public by definition.
  publicKey    String
  /// COSE algorithm: -7 is ES256, -257 is RS256.
  algorithm    Int
  /// What the person recognises it by — «آيفون العمل».
  label        String?
  /// The authenticator's own counter. One that fails to advance is what a
  /// cloned key produces, and it is refused.
  counter      Int       @default(0)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

/// THE CHALLENGE THE SERVER ISSUED, SPENT ONCE.
///
/// A signature over a challenge we did not issue is a replay. So it is
/// stored, matched, marked used, and expires on its own.
model PasskeyChallenge {
  id        String    @id @default(uuid())
  /// NULL for a LOGIN challenge: it is issued before anybody has said who
  /// they are. The browser finds a discoverable key, and the signature
  /// names the account — which is the whole point of signing in with a
  /// fingerprint instead of an address and a password.
  userId    String?
  challenge String
  /// REGISTER, AUTHENTICATE or LOGIN — a registration challenge must not
  /// be answered with a sign-in, nor the other way round, and a LOGIN
  /// challenge must not finish a half-done password login.
  kind      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("passkey_challenges")
}

/// A SETTING THAT BELONGS TO THE INSTALLATION, NOT TO A COMPANY.
///
/// Asked for in these words: «الذكاء الاصطناعي والنصوص: المزوّد والمفتاح ...
/// واحفظو للـ System». Everything configurable in this product until now
/// lived in `Company.settings`, which is right for a company's own choices —
/// its prompts, its wording, what its assistant may read. It is wrong for an
/// AI vendor account: the key is infrastructure. Somebody pays a vendor,
/// installs the system, and the models are simply THERE, the way a database
/// URL is there. Asking each company to paste the same key is asking the
/// same secret to be stored more times than it needs to be.
///
/// Key/value on purpose. A column per setting means a migration per setting,
/// and the thing being stored here is already a JSON document with its own
/// shape rules enforced in `ai-provider.ts`. The table's job is scope — one
/// row for the whole installation — not structure.
model SystemSetting {
  /// The setting's name, e.g. «ai». One row per subject.
  key         String   @id
  /// A JSON document. Secrets inside it are encrypted individually by the
  /// code that writes them, never by virtue of sitting in this column.
  value       String
  /// Who last changed it, for the same reason courier credentials record it:
  /// «who configured this» must have an answer. Not a foreign key — a
  /// deleted user must not take the installation's settings with them.
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}
